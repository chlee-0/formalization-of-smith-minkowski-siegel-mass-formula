import Mathlib.MeasureTheory.Constructions.BorelSpace.Basic
import Mathlib.Topology.Covering.Basic

/-!
# Borel structures of second-countable covering quotients

A surjective covering map has continuous local sections.  On a
second-countable target, a countable evenly-covered subcover therefore shows
that a set is Borel whenever its full preimage is Borel.  Consequently the
map-generated quotient measurable structure is exactly the target Borel
structure.  This avoids a Polish-space hypothesis on the source.
-/

open Set

namespace MeasurableSpace

/-- The measurable structure generated by a surjective covering map onto a
second-countable Borel space is its genuine Borel structure. -/
theorem map_borel_eq_borel_of_covering
    {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    [SecondCountableTopology Y]
    {f : X → Y} (hf : IsCoveringMap f) (hsurj : Function.Surjective f) :
    MeasurableSpace.map f (borel X) = borel Y := by
  letI : MeasurableSpace X := borel X
  letI : BorelSpace X := ⟨rfl⟩
  letI : MeasurableSpace Y := borel Y
  letI : BorelSpace Y := ⟨rfl⟩
  apply MeasurableSpace.ext
  intro s
  change (@MeasurableSet X (borel X) (f ⁻¹' s) ↔
    @MeasurableSet Y (borel Y) s)
  constructor
  · intro hs
    have hpre : MeasurableSet (f ⁻¹' s) := hs
    let U : Y → Set Y := fun y => (hf y).2.choose
    have hUopen : ∀ y, IsOpen (U y) := fun y =>
      (hf y).2.choose_spec.2.1
    have hyU : ∀ y, y ∈ U y := fun y =>
      (hf y).2.choose_spec.1
    obtain ⟨c, hc, hcover⟩ := isLindelof_univ.elim_countable_subcover
      U hUopen (by
        intro y _
        exact mem_iUnion.mpr ⟨y, hyU y⟩)
    have hpiece : ∀ y, MeasurableSet (s ∩ U y) := by
      intro y
      let x : X := Classical.choose (hsurj y)
      have hx : f x = y := Classical.choose_spec (hsurj y)
      let i : (f ⁻¹' ({y} : Set Y)) := ⟨x, hx⟩
      let H : (f ⁻¹' U y) ≃ₜ (U y) × (f ⁻¹' ({y} : Set Y)) :=
        (hf y).2.choose_spec.2.2.2.choose
      have hH : ∀ z, (H z).1.1 = f z :=
        (hf y).2.choose_spec.2.2.2.choose_spec
      let sec : U y → X := fun u => (H.symm (u, i)).1
      have hsec_cont : Continuous sec := by
        exact continuous_subtype_val.comp
          (H.symm.continuous.comp (continuous_id.prodMk continuous_const))
      have hsec : ∀ u : U y, f (sec u) = u := by
        intro u
        have hh := hH (H.symm (u, i))
        simpa [sec] using hh.symm
      have hsub : MeasurableSet
          (((↑) : U y → Y) ⁻¹' (s ∩ U y)) := by
        have hm := hsec_cont.measurable hpre
        convert (show MeasurableSet (sec ⁻¹' (f ⁻¹' s)) from hm) using 1
        ext u
        simp only [mem_preimage, mem_inter_iff, Subtype.coe_prop, and_true]
        rw [hsec]
      have himg := (MeasurableEmbedding.subtype_coe
        (hUopen y).measurableSet).measurableSet_image' hsub
      simpa only [Subtype.image_preimage_coe, inter_self,
        inter_assoc, inter_comm, inter_left_comm] using himg
    have hsu : s = ⋃ y ∈ c, (s ∩ U y) := by
      apply Set.Subset.antisymm
      · intro y hy
        have hyc : y ∈ ⋃ y ∈ c, U y := hcover (Set.mem_univ y)
        rcases Set.mem_iUnion.mp hyc with ⟨z, hz⟩
        rcases Set.mem_iUnion.mp hz with ⟨hzc, hyUz⟩
        exact Set.mem_iUnion.mpr ⟨z,
          Set.mem_iUnion.mpr ⟨hzc, hy, hyUz⟩⟩
      · exact iUnion₂_subset fun _ _ => inter_subset_left
    rw [hsu]
    exact MeasurableSet.biUnion hc fun y _ => hpiece y
  · intro hs
    exact hf.continuous.measurable hs

end MeasurableSpace
