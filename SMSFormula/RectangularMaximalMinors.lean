import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import Mathlib.RingTheory.Ideal.Operations

/-!
# Rectangular maximal minors

For a rectangular matrix `J : Matrix m n R`, maximal column minors are the
determinants obtained by restricting the columns along an embedding
`m ↪ n`.  This file proves the determinant expansion needed to show that
these minors generate the unit ideal whenever `J` has a right inverse.

The expansion is written first over all functions `p : m → n`:

```text
det (J * K) = ∑ p, det (J[:,p]) * ∏ i, K[p i,i].
```

Every noninjective choice has two equal columns and hence zero determinant.
This is the ungrouped rectangular Cauchy--Binet expansion; it avoids choosing
orders on the finite index types while retaining exactly the maximal-minor
ideal consequence needed for local Jacobian charts.
-/

noncomputable section

open scoped Matrix BigOperators
open Finset

namespace Matrix

variable {m n R : Type*}

/-- The determinant of a rectangular product, expanded over all choices of
one intermediate index for each output column. -/
theorem det_mul_rectangular_expansion
    [Fintype m] [DecidableEq m] [Fintype n] [CommRing R]
    (J : Matrix m n R) (K : Matrix n m R) :
    det (J * K) =
      ∑ p : m → n, det (J.submatrix id p) * ∏ i, K (p i) i := by
  calc
    det (J * K) =
        ∑ p : m → n, ∑ σ : Equiv.Perm m,
          ((Equiv.Perm.sign σ : ℤ) : R) *
            ∏ i, J (σ i) (p i) * K (p i) i := by
      simp only [det_apply', mul_apply, prod_univ_sum, mul_sum,
        Fintype.piFinset_univ]
      rw [Finset.sum_comm]
    _ = ∑ p : m → n,
          (∑ σ : Equiv.Perm m,
            ((Equiv.Perm.sign σ : ℤ) : R) * ∏ i, J (σ i) (p i)) *
              ∏ i, K (p i) i := by
      apply Finset.sum_congr rfl
      intro p _
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro σ _
      rw [Finset.prod_mul_distrib]
      ring
    _ = ∑ p : m → n, det (J.submatrix id p) * ∏ i, K (p i) i := by
      apply Finset.sum_congr rfl
      intro p _
      rw [det_apply']
      rfl

/-- A noninjective column choice has repeated columns and zero determinant. -/
theorem det_submatrix_id_eq_zero_of_not_injective
    [Fintype m] [DecidableEq m] [CommRing R]
    (J : Matrix m n R) {p : m → n} (hp : ¬ Function.Injective p) :
    det (J.submatrix id p) = 0 := by
  obtain ⟨i, j, hpij, hij⟩ := Function.not_injective_iff.mp hp
  exact det_zero_of_column_eq hij fun k => by simp [hpij]

/-- The ideal generated by the maximal column minors of a rectangular matrix. -/
def maximalColumnMinorIdeal
    [Fintype m] [DecidableEq m] [CommRing R]
    (J : Matrix m n R) : Ideal R :=
  Ideal.span (Set.range fun e : m ↪ n => det (J.submatrix id e))

/-- Every function-indexed column determinant lies in the maximal-minor ideal;
the noninjective cases vanish. -/
theorem det_submatrix_id_mem_maximalColumnMinorIdeal
    [Fintype m] [DecidableEq m] [CommRing R]
    (J : Matrix m n R) (p : m → n) :
    det (J.submatrix id p) ∈ maximalColumnMinorIdeal J := by
  by_cases hp : Function.Injective p
  · exact Ideal.subset_span ⟨⟨p, hp⟩, rfl⟩
  · rw [det_submatrix_id_eq_zero_of_not_injective J hp]
    exact (maximalColumnMinorIdeal J).zero_mem

/-- The determinant of `J * K` belongs to the maximal-column-minor ideal of
`J`. -/
theorem det_mul_mem_maximalColumnMinorIdeal
    [Fintype m] [DecidableEq m] [Fintype n] [CommRing R]
    (J : Matrix m n R) (K : Matrix n m R) :
    det (J * K) ∈ maximalColumnMinorIdeal J := by
  rw [det_mul_rectangular_expansion]
  apply (maximalColumnMinorIdeal J).sum_mem
  intro p _
  exact Ideal.mul_mem_right _ _
    (det_submatrix_id_mem_maximalColumnMinorIdeal J p)

/-- A rectangular matrix with a right inverse has unit maximal-column-minor
ideal. -/
theorem maximalColumnMinorIdeal_eq_top_of_mul_eq_one
    [Fintype m] [DecidableEq m] [Fintype n] [CommRing R]
    (J : Matrix m n R) (K : Matrix n m R) (h : J * K = 1) :
    maximalColumnMinorIdeal J = ⊤ := by
  apply (Ideal.eq_top_iff_one (maximalColumnMinorIdeal J)).mpr
  have hdet : det (J * K) = 1 := by rw [h, det_one]
  rw [← hdet]
  exact det_mul_mem_maximalColumnMinorIdeal J K

end Matrix
