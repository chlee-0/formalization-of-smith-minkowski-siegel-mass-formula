import Mathlib.Algebra.Category.Ring.Epi
import Mathlib.LinearAlgebra.Dual.Lemmas
import Mathlib.RingTheory.FiniteType
import Mathlib.RingTheory.Ideal.MinimalPrime.Localization
import Mathlib.RingTheory.KrullDimension.Zero
import Mathlib.RingTheory.LocalProperties.Reduced

/-!
# A generic principal isomorphism patch for injective finite-type ring epimorphisms

This file develops the commutative-algebra input for the algebraic-group
translation argument used by the rational Spin invariant quotient.  The first
step identifies the localization at a minimal prime of a reduced base as a
field.  The remaining steps show that an injective finite-type ring
epimorphism becomes an isomorphism after one principal localization meeting
that minimal prime.
-/

noncomputable section

open CategoryTheory Function TensorProduct
open scoped BigOperators

universe u v

namespace Algebra

variable {K S : Type*} [Field K] [CommRing S] [Algebra K S]

/-- A nonzero commutative algebra which is a ring epimorphism over a field is
generated by the scalars. -/
theorem surjective_algebraMap_of_isEpi_of_field [Nontrivial S] [Algebra.IsEpi K S] :
    Surjective (algebraMap K S) := by
  obtain ⟨f, hf⟩ := Module.Projective.exists_dual_eq_one K (one_ne_zero : (1 : S) ≠ 0)
  let F : S ⊗[K] S →ₗ[K] S :=
    _root_.TensorProduct.lift ((LinearMap.lsmul K S).comp f)
  intro s
  refine ⟨f s, ?_⟩
  have h := (Algebra.isEpi_iff_forall_one_tmul_eq K S).mp inferInstance s
  have hF := congr_arg F h
  simpa [F, hf, Algebra.smul_def] using hF.symm

end Algebra

namespace IsLocalization

variable {R : Type u} [CommRing R] [IsReduced R]

/-- The localization of a reduced ring at one of its minimal primes is a
field. -/
theorem isField_of_mem_minimalPrimes (p : Ideal R) (hp : p ∈ minimalPrimes R)
    (Rₚ : Type u) [CommRing Rₚ] [Algebra R Rₚ]
    [IsLocalization.AtPrime Rₚ p (hp := hp.1.1)] : IsField Rₚ := by
  letI : p.IsPrime := hp.1.1
  letI : IsReduced Rₚ := isReduced_localizationPreserves p.primeCompl Rₚ inferInstance
  letI : Ring.KrullDimLE 0 Rₚ := Ring.KrullDimLE.of_isLocalization p hp Rₚ
  letI : IsLocalRing Rₚ := IsLocalization.AtPrime.isLocalRing Rₚ p
  exact Ring.KrullDimLE.isField_of_isReduced

end IsLocalization

namespace Algebra

variable {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]

/-- Simultaneously localizing the source and target of a commutative ring
epimorphism again gives a commutative ring epimorphism. -/
theorem IsEpi.localization (M : Submonoid R) [Algebra.IsEpi R S]
    (Rₘ Sₘ : Type u) [CommRing Rₘ] [CommRing Sₘ]
    [Algebra R Rₘ] [IsLocalization M Rₘ]
    [Algebra S Sₘ] [Algebra R Sₘ] [IsScalarTower R S Sₘ]
    [IsLocalization (Algebra.algebraMapSubmonoid S M) Sₘ]
    [Algebra Rₘ Sₘ] [IsScalarTower R Rₘ Sₘ] :
    Algebra.IsEpi Rₘ Sₘ := by
  rw [← CommRingCat.epi_iff_epi]
  constructor
  intro T f g h
  apply ConcreteCategory.hom_ext
  let fS : CommRingCat.of S ⟶ T :=
    CommRingCat.ofHom (f.hom.comp (algebraMap S _))
  let gS : CommRingCat.of S ⟶ T :=
    CommRingCat.ofHom (g.hom.comp (algebraMap S _))
  haveI : Epi (CommRingCat.ofHom (algebraMap R S)) :=
    CommRingCat.epi_iff_epi.mpr inferInstance
  have hfg : fS = gS := by
    apply (cancel_epi (CommRingCat.ofHom (algebraMap R S))).mp
    apply ConcreteCategory.hom_ext
    intro r
    have hh := congrArg (fun q : CommRingCat.of Rₘ ⟶ T => q.hom) h
    have hr := RingHom.congr_fun hh (algebraMap R Rₘ r)
    change f.hom (algebraMap S Sₘ (algebraMap R S r)) =
      g.hom (algebraMap S Sₘ (algebraMap R S r))
    rw [← IsScalarTower.algebraMap_apply R S Sₘ]
    simpa [IsScalarTower.algebraMap_apply R Rₘ Sₘ] using hr
  exact RingHom.congr_fun <| IsLocalization.ringHom_ext
    (Algebra.algebraMapSubmonoid S M) (congrArg ConcreteCategory.hom hfg)

/-- Surjectivity after simultaneously localizing a ring map supplies one
numerator and one denominator from the base for every target element. -/
theorem exists_eq_mul_of_localization_surjective (M : Submonoid R)
    (Rₘ Sₘ : Type u) [CommRing Rₘ] [CommRing Sₘ]
    [Algebra R Rₘ] [IsLocalization M Rₘ]
    [Algebra S Sₘ] [Algebra R Sₘ] [IsScalarTower R S Sₘ]
    [IsLocalization (Algebra.algebraMapSubmonoid S M) Sₘ]
    [Algebra Rₘ Sₘ] [IsScalarTower R Rₘ Sₘ]
    (hsurj : Surjective (algebraMap Rₘ Sₘ)) (s : S) :
    ∃ a d : R, d ∈ M ∧ algebraMap R S a = algebraMap R S d * s := by
  obtain ⟨z, hz⟩ := hsurj (algebraMap S Sₘ s)
  obtain ⟨a, t, ht⟩ := IsLocalization.exists_mk'_eq M z
  subst z
  rw [IsLocalization.algebraMap_mk' S Rₘ Sₘ] at hz
  have hz' : IsLocalization.mk' Sₘ (algebraMap R S a)
      ⟨algebraMap R S t, Algebra.mem_algebraMapSubmonoid_of_mem t⟩ =
      IsLocalization.mk' Sₘ s
        (1 : Algebra.algebraMapSubmonoid S M) := by
    simpa only [IsLocalization.mk'_one] using hz
  rw [IsLocalization.eq] at hz'
  obtain ⟨c, hc⟩ := hz'
  obtain ⟨u, hu, huc⟩ := c.2
  refine ⟨u * a, u * t, M.mul_mem hu t.2, ?_⟩
  simpa [← huc, map_mul, mul_assoc] using hc

/-- At a minimal prime of a reduced base, an injective commutative ring
epimorphism becomes an isomorphism after localizing by the complement of that
prime. -/
theorem bijective_atMinimalPrime [IsReduced R] [Algebra.IsEpi R S]
    (hinj : Injective (algebraMap R S))
    (p : Ideal R) (hp : p ∈ minimalPrimes R) :
    letI : p.IsPrime := hp.1.1
    let Rₚ := Localization.AtPrime p
    let Sₚ := Localization (Algebra.algebraMapSubmonoid S p.primeCompl)
    Function.Bijective (algebraMap Rₚ Sₚ) := by
  dsimp only
  letI : p.IsPrime := hp.1.1
  letI : Algebra (Localization.AtPrime p)
      (Localization (Algebra.algebraMapSubmonoid S p.primeCompl)) :=
    localizationAlgebra p.primeCompl S
  letI : IsScalarTower R (Localization.AtPrime p)
      (Localization (Algebra.algebraMapSubmonoid S p.primeCompl)) := inferInstance
  have hfield := IsLocalization.isField_of_mem_minimalPrimes p hp (Localization.AtPrime p)
  letI : Field (Localization.AtPrime p) := hfield.toField
  have hinj' : Injective (algebraMap (Localization.AtPrime p)
      (Localization (Algebra.algebraMapSubmonoid S p.primeCompl))) :=
    localizationAlgebra_injective
      (M := p.primeCompl) (S := S)
      (Rₘ := Localization.AtPrime p)
      (Sₘ := Localization (Algebra.algebraMapSubmonoid S p.primeCompl)) hinj
  letI : Nontrivial (Localization (Algebra.algebraMapSubmonoid S p.primeCompl)) :=
    hinj'.nontrivial
  letI : Algebra.IsEpi (Localization.AtPrime p)
      (Localization (Algebra.algebraMapSubmonoid S p.primeCompl)) :=
    Algebra.IsEpi.localization (R := R) (S := S) p.primeCompl
      (Localization.AtPrime p)
      (Localization (Algebra.algebraMapSubmonoid S p.primeCompl))
  exact ⟨hinj', Algebra.surjective_algebraMap_of_isEpi_of_field⟩

/-- An injective finite-type commutative ring epimorphism out of a reduced
ring is an isomorphism on one principal neighborhood meeting each minimal
prime. -/
theorem exists_awayMap_bijective_of_mem_minimalPrimes
    [IsReduced R] [Algebra.IsEpi R S] [Algebra.FiniteType R S]
    (hinj : Injective (algebraMap R S))
    (p : Ideal R) (hp : p ∈ minimalPrimes R) :
    ∃ d : R, d ∉ p ∧
      Function.Bijective (Localization.awayMap (algebraMap R S) d) := by
  classical
  letI : p.IsPrime := hp.1.1
  let Rₚ := Localization.AtPrime p
  let Sₚ := Localization (Algebra.algebraMapSubmonoid S p.primeCompl)
  have hlocal : Function.Bijective (algebraMap Rₚ Sₚ) :=
    Algebra.bijective_atMinimalPrime hinj p hp
  obtain ⟨gens, hgens⟩ := (inferInstance : Algebra.FiniteType R S).out
  have hgen (x : gens) :
      ∃ a d : R, d ∈ p.primeCompl ∧
        algebraMap R S a = algebraMap R S d * x.1 :=
    Algebra.exists_eq_mul_of_localization_surjective p.primeCompl Rₚ Sₚ hlocal.2 x.1
  choose a den hden heq using hgen
  let d : R := ∏ x : gens, den x
  have hd : d ∈ p.primeCompl := by
    exact Submonoid.prod_mem _ fun x _ ↦ hden x
  let T : Subalgebra R S := {
    carrier := {x | ∃ b m, algebraMap R S b = algebraMap R S d ^ m * x}
    mul_mem' := by
      rintro x y ⟨bx, mx, hx⟩ ⟨by', my, hy⟩
      refine ⟨bx * by', mx + my, ?_⟩
      rw [map_mul, hx, hy, pow_add]
      ring
    one_mem' := ⟨1, 0, by simp⟩
    add_mem' := by
      rintro x y ⟨bx, mx, hx⟩ ⟨by', my, hy⟩
      refine ⟨bx * d ^ my + by' * d ^ mx, mx + my, ?_⟩
      rw [map_add, map_mul, map_mul, map_pow, map_pow, hx, hy, pow_add]
      ring
    zero_mem' := ⟨0, 0, by simp⟩
    algebraMap_mem' := fun r ↦ ⟨r, 0, by simp⟩ }
  have hgensT : (gens : Set S) ⊆ T := by
    intro x hx
    let i : gens := ⟨x, hx⟩
    obtain ⟨q, hq⟩ := Finset.dvd_prod_of_mem den (Finset.mem_univ i)
    refine ⟨a i * q, 1, ?_⟩
    rw [map_mul, heq i, pow_one]
    simp only [d] at hq ⊢
    rw [hq, map_mul]
    ring
  have hT : T = ⊤ := by
    apply top_unique
    rw [← hgens]
    exact Algebra.adjoin_le hgensT
  have hall (x : S) : ∃ b m, algebraMap R S b = algebraMap R S d ^ m * x := by
    have hx : x ∈ T := by simp [hT]
    exact hx
  have hsurj : Function.Surjective (Localization.awayMap (algebraMap R S) d) :=
    Localization.awayMap_surjective_iff.mpr hall
  have hinjAway : Function.Injective (Localization.awayMap (algebraMap R S) d) :=
    Localization.awayMap_injective_iff.mpr fun x hx ↦ ⟨0, by
      have hx0 : x = 0 := hinj (by simpa using hx)
      simp [hx0]⟩
  exact ⟨d, hd, hinjAway, hsurj⟩

end Algebra
