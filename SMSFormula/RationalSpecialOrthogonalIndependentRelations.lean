import SMSFormula.RationalSpecialOrthogonalSmoothnessPrecursor

/-!
# Independent symmetric relations for the rational special orthogonal carrier

The existing affine carrier uses every entry of

```text
Xᵀ F X - F
```

as a polynomial relation.  This matrix is symmetric, so the lower-triangular
relations duplicate the upper-triangular ones.  This file defines the
upper-triangular relation family and proves that, after adjoining the same
determinant-one relation, it generates the same coordinate ideal.

This removes one redundancy in the presentation.  It does not prove that
the resulting presentation is submersive: the determinant-one relation and
its interaction with the independent orthogonality equations need a separate
Jacobian argument.
-/

noncomputable section

open scoped Matrix

namespace RationalQuadraticSpaceMatrix

variable {n : ℕ} (V : RationalQuadraticSpaceMatrix n)

/-- The universal matrix of orthogonality relations. -/
def specialOrthogonalRelationMatrix :
    Matrix (Fin n) (Fin n) (specialOrthogonalPolynomialRing (n := n)) :=
  (specialOrthogonalUniversalMatrix (n := n)).transpose *
      V.specialOrthogonalFormMatrixPolynomial *
        specialOrthogonalUniversalMatrix (n := n) -
    V.specialOrthogonalFormMatrixPolynomial

@[simp]
theorem specialOrthogonalRelationMatrix_apply (i j : Fin n) :
    V.specialOrthogonalRelationMatrix i j =
      V.specialOrthogonalRelation i j :=
  rfl

/-- The universal orthogonality-relation matrix is symmetric. -/
theorem specialOrthogonalRelationMatrix_isSymm :
    V.specialOrthogonalRelationMatrix.IsSymm := by
  have hF : V.specialOrthogonalFormMatrixPolynomial.IsSymm :=
    V.form_symm.map MvPolynomial.C
  change
    ((specialOrthogonalUniversalMatrix (n := n)).transpose *
          V.specialOrthogonalFormMatrixPolynomial *
            specialOrthogonalUniversalMatrix (n := n) -
        V.specialOrthogonalFormMatrixPolynomial).transpose = _
  simp [specialOrthogonalRelationMatrix, Matrix.transpose_sub,
    Matrix.transpose_mul, Matrix.transpose_transpose, hF.eq,
    Matrix.mul_assoc]

/-- Orthogonality relations are unchanged when their two indices are swapped. -/
theorem specialOrthogonalRelation_comm (i j : Fin n) :
    V.specialOrthogonalRelation i j = V.specialOrthogonalRelation j i := by
  have h := congrFun (congrFun V.specialOrthogonalRelationMatrix_isSymm.eq i) j
  exact h.symm

/-- The upper-triangular index type for independent symmetric relations. -/
abbrev SpecialOrthogonalIndependentRelationIndex :=
  {ij : Fin n × Fin n // ij.1 ≤ ij.2}

/-- The full family of orthogonality relations, without the determinant-one
relation. -/
def specialOrthogonalOrthogonalityRelationSet :
    Set (specialOrthogonalPolynomialRing (n := n)) :=
  Set.range (fun ij : Fin n × Fin n =>
    V.specialOrthogonalRelation ij.1 ij.2)

/-- The ideal generated by all entries of the orthogonality relation matrix,
without the determinant-one relation. -/
def specialOrthogonalOrthogonalityRelationIdeal :
    Ideal (specialOrthogonalPolynomialRing (n := n)) :=
  Ideal.span V.specialOrthogonalOrthogonalityRelationSet

/-- The independent upper-triangular orthogonality relations. -/
def specialOrthogonalIndependentOrthogonalityRelationSet :
    Set (specialOrthogonalPolynomialRing (n := n)) :=
  Set.range (fun ij : SpecialOrthogonalIndependentRelationIndex (n := n) =>
    V.specialOrthogonalRelation ij.1.1 ij.1.2)

/-- The ideal generated by the independent upper-triangular orthogonality
relations. -/
def specialOrthogonalIndependentOrthogonalityRelationIdeal :
    Ideal (specialOrthogonalPolynomialRing (n := n)) :=
  Ideal.span V.specialOrthogonalIndependentOrthogonalityRelationSet

/-- The independent upper-triangular orthogonality relations, together with
the determinant-one relation. -/
def specialOrthogonalIndependentRelationSet :
    Set (specialOrthogonalPolynomialRing (n := n)) :=
  V.specialOrthogonalIndependentOrthogonalityRelationSet ∪
    {V.specialOrthogonalDetRelation}

/-- The ideal generated by the independent upper-triangular orthogonality
relations and the determinant-one relation. -/
def specialOrthogonalIndependentRelationIdeal :
    Ideal (specialOrthogonalPolynomialRing (n := n)) :=
  Ideal.span V.specialOrthogonalIndependentRelationSet

/-- Every original relation belongs to the ideal generated by the independent
upper-triangular family. -/
theorem specialOrthogonalRelation_mem_independentOrthogonalityRelationIdeal
    (i j : Fin n) :
    V.specialOrthogonalRelation i j ∈
      V.specialOrthogonalIndependentOrthogonalityRelationIdeal := by
  rcases le_total i j with hij | hji
  · apply Ideal.subset_span
    exact ⟨⟨(i, j), hij⟩, rfl⟩
  · rw [V.specialOrthogonalRelation_comm i j]
    apply Ideal.subset_span
    exact ⟨⟨(j, i), hji⟩, rfl⟩

/-- The full `n²` orthogonality ideal is generated by the upper-triangular
relations. -/
theorem specialOrthogonalIndependentOrthogonalityRelationIdeal_eq :
    V.specialOrthogonalIndependentOrthogonalityRelationIdeal =
      V.specialOrthogonalOrthogonalityRelationIdeal := by
  apply le_antisymm
  · apply Ideal.span_le.2
    intro p hp
    apply Ideal.subset_span
    rcases hp with ⟨ij, rfl⟩
    exact ⟨ij.1, rfl⟩
  · apply Ideal.span_le.2
    intro p hp
    rcases hp with ⟨ij, rfl⟩
    exact
      V.specialOrthogonalRelation_mem_independentOrthogonalityRelationIdeal
        ij.1 ij.2

/-- Every original orthogonality relation also belongs to the independent
special-orthogonal ideal after the determinant-one relation is adjoined. -/
theorem specialOrthogonalRelation_mem_independentRelationIdeal (i j : Fin n) :
    V.specialOrthogonalRelation i j ∈
      V.specialOrthogonalIndependentRelationIdeal := by
  exact (Ideal.span_mono Set.subset_union_left) <|
    V.specialOrthogonalRelation_mem_independentOrthogonalityRelationIdeal i j

/-- The independent relation ideal is literally the existing special-
orthogonal relation ideal. -/
theorem specialOrthogonalIndependentRelationIdeal_eq :
    V.specialOrthogonalIndependentRelationIdeal =
      V.specialOrthogonalRelationIdeal := by
  apply le_antisymm
  · apply Ideal.span_le.2
    intro p hp
    apply Ideal.subset_span
    rcases hp with hp | hp
    · rcases hp with ⟨ij, rfl⟩
      exact Or.inl ⟨ij.1, rfl⟩
    · exact Or.inr hp
  · apply Ideal.span_le.2
    intro p hp
    rcases hp with hp | hp
    · rcases hp with ⟨ij, rfl⟩
      exact V.specialOrthogonalRelation_mem_independentRelationIdeal ij.1 ij.2
    · rw [Set.mem_singleton_iff.mp hp]
      apply Ideal.subset_span
      exact Or.inr (Set.mem_singleton _)

end RationalQuadraticSpaceMatrix
