import Mathlib.LinearAlgebra.CliffordAlgebra.Conjugation
import Mathlib.LinearAlgebra.CliffordAlgebra.Grading

/-!
# Clifford normal forms for three pairwise orthogonal vectors

For pairwise orthogonal `v₀, v₁, v₂` (`eᵢ = ι(vᵢ)`, `fᵢ = Q(vᵢ)`):
* the volume element `ν = e₀e₁e₂` is central in the span generated by the `eᵢ` (`gen_mul_volume`), with
  `ν² = −f₀f₁f₂`, `reverse ν = −ν`, `involute ν = −ν`;
* when the `vᵢ` span `M`, the even part is spanned by `1, e₀e₁, e₀e₂, e₁e₂` (`mem_evenSpan_of_mem_even`).
Nothing is chosen.
-/

noncomputable section

set_option linter.unusedSimpArgs false

namespace CliffordAlgebra.OrthogonalTriple

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] (Q : QuadraticForm R M)
variable (v : Fin 3 → M) (hv : ∀ i j, i ≠ j → Q.IsOrtho (v i) (v j))

/-- The Clifford generator `eᵢ = ι(vᵢ)`. -/
abbrev gen (i : Fin 3) : CliffordAlgebra Q := ι Q (v i)

local notation "𝔢" => gen Q v

include hv

theorem gen_swap {i j : Fin 3} (hij : i ≠ j) : 𝔢 j * 𝔢 i = -(𝔢 i * 𝔢 j) :=
  ι_mul_ι_comm_of_isOrtho (hv j i hij.symm)

theorem gen_swap_assoc {i j : Fin 3} (hij : i ≠ j) (y : CliffordAlgebra Q) :
    𝔢 j * (𝔢 i * y) = -(𝔢 i * (𝔢 j * y)) := by
  rw [← mul_assoc, gen_swap Q v hv hij, neg_mul, mul_assoc]

omit hv in
theorem gen_sq (i : Fin 3) : 𝔢 i * 𝔢 i = algebraMap R _ (Q (v i)) := ι_sq_scalar Q (v i)

omit hv in
theorem gen_sq_assoc (i : Fin 3) (y : CliffordAlgebra Q) : 𝔢 i * (𝔢 i * y) = Q (v i) • y := by
  rw [← mul_assoc, gen_sq, Algebra.smul_def]

theorem e10 : 𝔢 1 * 𝔢 0 = -(𝔢 0 * 𝔢 1) := gen_swap Q v hv (by decide)
theorem e20 : 𝔢 2 * 𝔢 0 = -(𝔢 0 * 𝔢 2) := gen_swap Q v hv (by decide)
theorem e21 : 𝔢 2 * 𝔢 1 = -(𝔢 1 * 𝔢 2) := gen_swap Q v hv (by decide)
theorem e10a (y : CliffordAlgebra Q) : 𝔢 1 * (𝔢 0 * y) = -(𝔢 0 * (𝔢 1 * y)) :=
  gen_swap_assoc Q v hv (by decide) y
theorem e20a (y : CliffordAlgebra Q) : 𝔢 2 * (𝔢 0 * y) = -(𝔢 0 * (𝔢 2 * y)) :=
  gen_swap_assoc Q v hv (by decide) y
theorem e21a (y : CliffordAlgebra Q) : 𝔢 2 * (𝔢 1 * y) = -(𝔢 1 * (𝔢 2 * y)) :=
  gen_swap_assoc Q v hv (by decide) y

omit hv in
/-- The volume element `ν = e₀e₁e₂`. -/
def volume : CliffordAlgebra Q := 𝔢 0 * (𝔢 1 * 𝔢 2)

local notation "𝔫" => volume Q v

/-- `ν² = −f₀f₁f₂`. -/
theorem volume_mul_volume : 𝔫 * 𝔫 = -algebraMap R _ (Q (v 0) * Q (v 1) * Q (v 2)) := by
  unfold volume
  simp only [mul_assoc, e10a Q v hv, e20a Q v hv, e21a Q v hv, e10 Q v hv, e20 Q v hv, e21 Q v hv,
    neg_mul, mul_neg, neg_neg, gen_sq_assoc, gen_sq, mul_smul_comm, smul_neg, smul_smul]
  rw [Algebra.smul_def, ← map_mul]
  congr 2
  ring

/-- The volume element commutes with every generator. -/
theorem gen_mul_volume (i : Fin 3) : 𝔢 i * 𝔫 = 𝔫 * 𝔢 i := by
  unfold volume
  fin_cases i <;>
  · simp only [mul_assoc, e10a Q v hv, e20a Q v hv, e21a Q v hv, e10 Q v hv, e20 Q v hv, e21 Q v hv,
      neg_mul, mul_neg, neg_neg, gen_sq_assoc, gen_sq, mul_smul_comm, smul_neg, smul_smul, Fin.zero_eta,
      Fin.mk_one, Fin.reduceFinMk]

omit hv in
theorem involute_volume : involute 𝔫 = -𝔫 := by
  unfold volume
  simp only [map_mul, involute_ι, neg_mul, mul_neg, neg_neg]

theorem reverse_volume : reverse 𝔫 = -𝔫 := by
  unfold volume
  simp only [reverse.map_mul, reverse_ι]
  simp only [mul_assoc, e10a Q v hv, e20a Q v hv, e21a Q v hv, e10 Q v hv, e20 Q v hv, e21 Q v hv,
    neg_mul, mul_neg, neg_neg]

/-- Every vector of the span of the `vᵢ` commutes with the volume element. -/
theorem ι_mul_volume_of_mem_span {m : M} (hm : m ∈ Submodule.span R (Set.range v)) :
    ι Q m * 𝔫 = 𝔫 * ι Q m := by
  induction hm using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact gen_mul_volume Q v hv i
  | zero => simp
  | add x y _ _ hx hy => simp only [map_add, add_mul, mul_add, hx, hy]
  | smul r x _ hx => simp only [map_smul, smul_mul_assoc, mul_smul_comm, hx]

/-! ## The even span -/

omit hv in
/-- The span of `1, e₀e₁, e₀e₂, e₁e₂`. -/
def evenSpan : Submodule R (CliffordAlgebra Q) :=
  Submodule.span R {1, 𝔢 0 * 𝔢 1, 𝔢 0 * 𝔢 2, 𝔢 1 * 𝔢 2}

theorem gen_mul_gen_mul_mem_evenSpan (i j : Fin 3) {y : CliffordAlgebra Q} (hy : y ∈ evenSpan Q v) :
    𝔢 i * (𝔢 j * y) ∈ evenSpan Q v := by
  induction hy using Submodule.span_induction with
  | mem x hx =>
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    have h1 : (1 : CliffordAlgebra Q) ∈ evenSpan Q v := Submodule.subset_span (by simp)
    have h01 : 𝔢 0 * 𝔢 1 ∈ evenSpan Q v := Submodule.subset_span (by simp)
    have h02 : 𝔢 0 * 𝔢 2 ∈ evenSpan Q v := Submodule.subset_span (by simp)
    have h12 : 𝔢 1 * 𝔢 2 ∈ evenSpan Q v := Submodule.subset_span (by simp)
    have hneg : ∀ z, z ∈ evenSpan Q v → -z ∈ evenSpan Q v := fun z hz ↦ Submodule.neg_mem _ hz
    have hsmul : ∀ (r : R) z, z ∈ evenSpan Q v → r • z ∈ evenSpan Q v := fun r z hz ↦ Submodule.smul_mem _ r hz
    rcases hx with rfl | rfl | rfl | rfl <;> fin_cases i <;> fin_cases j <;>
    · simp only [mul_one, mul_assoc, e10a Q v hv, e20a Q v hv, e21a Q v hv, e10 Q v hv, e20 Q v hv, e21 Q v hv,
        neg_mul, mul_neg, neg_neg, gen_sq_assoc, gen_sq, mul_smul_comm, smul_mul_assoc, smul_neg, smul_smul,
        Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Algebra.algebraMap_eq_smul_one]
      apply_rules [Submodule.smul_mem, Submodule.neg_mem]
  | zero => simp
  | add x y _ _ hx hy => simpa only [mul_add] using Submodule.add_mem _ hx hy
  | smul r x _ hx => simpa only [mul_smul_comm] using Submodule.smul_mem _ r hx

theorem ι_mul_ι_mul_mem_evenSpan {m₁ m₂ : M} (h₁ : m₁ ∈ Submodule.span R (Set.range v))
    (h₂ : m₂ ∈ Submodule.span R (Set.range v)) {y : CliffordAlgebra Q} (hy : y ∈ evenSpan Q v) :
    ι Q m₁ * (ι Q m₂ * y) ∈ evenSpan Q v := by
  induction h₁ using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    induction h₂ using Submodule.span_induction with
    | mem x' hx' =>
      obtain ⟨j, rfl⟩ := hx'
      exact gen_mul_gen_mul_mem_evenSpan Q v hv i j hy
    | zero => simp
    | add x y _ _ hx hy => simpa only [map_add, add_mul, mul_add] using Submodule.add_mem _ hx hy
    | smul r x _ hx => simpa only [map_smul, smul_mul_assoc, mul_smul_comm] using Submodule.smul_mem _ r hx
  | zero => simp
  | add x y _ _ hx hy => simpa only [map_add, add_mul] using Submodule.add_mem _ hx hy
  | smul r x _ hx => simpa only [map_smul, smul_mul_assoc] using Submodule.smul_mem _ r hx

/-- The even part is spanned by `1, e₀e₁, e₀e₂, e₁e₂` (when the `vᵢ` span `M`). -/
theorem mem_evenSpan_of_mem_even (hspan : ∀ m : M, m ∈ Submodule.span R (Set.range v))
    {x : CliffordAlgebra Q} (hx : x ∈ evenOdd Q 0) : x ∈ evenSpan Q v := by
  induction x, hx using even_induction with
  | algebraMap r =>
    rw [Algebra.algebraMap_eq_smul_one]
    exact Submodule.smul_mem _ r (Submodule.subset_span (by simp))
  | add x y _ _ hx hy => exact Submodule.add_mem _ hx hy
  | ι_mul_ι_mul m₁ m₂ x _ hx =>
    rw [mul_assoc]
    exact ι_mul_ι_mul_mem_evenSpan Q v hv (hspan m₁) (hspan m₂) hx

/-! ## Coordinates on the even span -/

omit hv in
/-- The even element `h₀ + h₁ e₀e₁ + h₂ e₀e₂ + h₃ e₁e₂`. -/
def evenElem (h : Fin 4 → R) : CliffordAlgebra Q :=
  algebraMap R _ (h 0) + h 1 • (𝔢 0 * 𝔢 1) + h 2 • (𝔢 0 * 𝔢 2) + h 3 • (𝔢 1 * 𝔢 2)

omit hv in
/-- The coordinate product (the quaternion multiplication table in the basis `1, e₀e₁, e₀e₂, e₁e₂`). -/
def evenMul (h k : Fin 4 → R) : Fin 4 → R :=
  ![h 0 * k 0 - Q (v 0) * Q (v 1) * h 1 * k 1 - Q (v 0) * Q (v 2) * h 2 * k 2 - Q (v 1) * Q (v 2) * h 3 * k 3,
    h 0 * k 1 + h 1 * k 0 - Q (v 2) * h 2 * k 3 + Q (v 2) * h 3 * k 2,
    h 0 * k 2 + h 2 * k 0 + Q (v 1) * h 1 * k 3 - Q (v 1) * h 3 * k 1,
    h 0 * k 3 + h 3 * k 0 - Q (v 0) * h 1 * k 2 + Q (v 0) * h 2 * k 1]

omit hv in
/-- The coordinate conjugation. -/
def evenConj (h : Fin 4 → R) : Fin 4 → R := ![h 0, -h 1, -h 2, -h 3]

omit hv in
/-- The norm `N(h) = h₀² + f₀f₁ h₁² + f₀f₂ h₂² + f₁f₂ h₃²`. -/
def evenNorm (h : Fin 4 → R) : R :=
  h 0 ^ 2 + Q (v 0) * Q (v 1) * h 1 ^ 2 + Q (v 0) * Q (v 2) * h 2 ^ 2 + Q (v 1) * Q (v 2) * h 3 ^ 2

set_option maxHeartbeats 1600000 in
theorem evenElem_mul_evenElem (h k : Fin 4 → R) :
    evenElem Q v h * evenElem Q v k = evenElem Q v (evenMul Q v h k) := by
  unfold evenElem evenMul
  simp only [add_mul, mul_add, Algebra.smul_def, mul_assoc, ← map_mul]
  simp only [← Algebra.smul_def, Algebra.commutes, mul_smul_comm, smul_mul_assoc, smul_smul, e10a Q v hv,
    e20a Q v hv, e21a Q v hv, e10 Q v hv, e20 Q v hv, e21 Q v hv, neg_mul, mul_neg, neg_neg, gen_sq_assoc,
    gen_sq, smul_neg, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.head_cons, Matrix.tail_cons, Algebra.algebraMap_eq_smul_one, mul_one, one_mul]
  module

theorem reverse_evenElem (h : Fin 4 → R) : reverse (evenElem Q v h) = evenElem Q v (evenConj h) := by
  unfold evenElem evenConj
  simp only [map_add, map_smul, reverse.commutes, reverse.map_mul, reverse_ι, e10 Q v hv, e20 Q v hv,
    e21 Q v hv, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.head_cons, Matrix.tail_cons, smul_neg, neg_smul]

omit hv in
theorem evenElem_single_zero (r : R) : evenElem Q v ![r, 0, 0, 0] = algebraMap R _ r := by
  unfold evenElem
  simp

/-- `h h̄ = N(h)`. -/
theorem evenElem_mul_reverse (h : Fin 4 → R) :
    evenElem Q v h * reverse (evenElem Q v h) = algebraMap R _ (evenNorm Q v h) := by
  rw [reverse_evenElem Q v hv, evenElem_mul_evenElem Q v hv, ← evenElem_single_zero]
  congr 1
  funext i
  fin_cases i <;> simp [evenMul, evenConj, evenNorm] <;> ring

/-- Every element of the even span has coordinates. -/
theorem exists_evenElem_of_mem_evenSpan {x : CliffordAlgebra Q} (hx : x ∈ evenSpan Q v) :
    ∃ h : Fin 4 → R, x = evenElem Q v h := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact ⟨![1, 0, 0, 0], by rw [evenElem_single_zero, map_one]⟩
    · exact ⟨![0, 1, 0, 0], by simp [evenElem]⟩
    · exact ⟨![0, 0, 1, 0], by simp [evenElem]⟩
    · exact ⟨![0, 0, 0, 1], by simp [evenElem]⟩
  | zero => exact ⟨0, by simp [evenElem]⟩
  | add x y _ _ hx hy =>
    obtain ⟨h, rfl⟩ := hx
    obtain ⟨k, rfl⟩ := hy
    refine ⟨h + k, ?_⟩
    simp only [evenElem, Pi.add_apply, map_add, add_smul]
    abel
  | smul r x _ hx =>
    obtain ⟨h, rfl⟩ := hx
    refine ⟨r • h, ?_⟩
    simp only [evenElem, Pi.smul_apply, smul_eq_mul, Algebra.algebraMap_eq_smul_one]
    module

/-- A vector times the volume element: `(Σ cᵢ eᵢ) ν = f₂c₂ e₀e₁ − f₁c₁ e₀e₂ + f₀c₀ e₁e₂`. -/
theorem vector_mul_volume (c : Fin 3 → R) :
    (c 0 • 𝔢 0 + c 1 • 𝔢 1 + c 2 • 𝔢 2) * volume Q v =
      evenElem Q v ![0, Q (v 2) * c 2, -(Q (v 1) * c 1), Q (v 0) * c 0] := by
  unfold volume evenElem
  simp only [add_mul, smul_mul_assoc, mul_assoc, e10a Q v hv, e20a Q v hv, e21a Q v hv, e10 Q v hv,
    e20 Q v hv, e21 Q v hv, neg_mul, mul_neg, neg_neg, gen_sq_assoc, gen_sq, mul_smul_comm, smul_neg,
    smul_smul, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.head_cons, Matrix.tail_cons, map_zero, zero_add, Algebra.algebraMap_eq_smul_one, mul_one]
  module

end CliffordAlgebra.OrthogonalTriple
