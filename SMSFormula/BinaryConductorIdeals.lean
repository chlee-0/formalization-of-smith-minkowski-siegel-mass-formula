import SMSFormula.BinaryOrderUnits

/-!
# Connecting ideals at the conductor

The maximal order is viewed as a fractional ideal of the original order.
Residue inverse pairs give explicit inverse fractional ideals. No
invertibility of the maximal order as an original-order module is assumed.
-/

open scoped nonZeroDivisors

namespace FractionalIdeal

variable {R F : Type*} [CommRing R] [Field F]
  [Algebra R F] [IsFractionRing R F]

/-- The actual original-order line generated by a residue lift and the
conductor ideal. The conductor need not itself be invertible. -/
noncomputable def conductorLine (J : FractionalIdeal R⁰ F) (u : F) : FractionalIdeal R⁰ F :=
  spanSingleton R⁰ u + J

theorem conductor_le_conductorLine (J : FractionalIdeal R⁰ F) (u : F) :
    J ≤ conductorLine J u := le_sup_right

theorem generator_mem_conductorLine (J : FractionalIdeal R⁰ F) (u : F) :
    u ∈ conductorLine J u :=
  (show spanSingleton R⁰ u ≤ conductorLine J u from le_sup_left)
    (mem_spanSingleton_self R⁰ u)

theorem conductorLine_eq_of_sub_mem (J : FractionalIdeal R⁰ F) (u v : F)
    (h : u-v ∈ J) : conductorLine J u = conductorLine J v := by
  have hJ (x : F) : J ≤ conductorLine J x := le_sup_right
  have hx (x : F) : x ∈ conductorLine J x :=
    generator_mem_conductorLine J x
  apply le_antisymm
  · apply sup_le _ (hJ v)
    apply spanSingleton_le_iff_mem.mpr
    have hh := (conductorLine J v : Submodule R F).add_mem (hx v) (hJ v h)
    simpa using hh
  · apply sup_le _ (hJ u)
    apply spanSingleton_le_iff_mem.mpr
    have hh := (conductorLine J u : Submodule R F).sub_mem (hx u) (hJ u h)
    simpa using hh

theorem conductorLine_one (J : FractionalIdeal R⁰ F) (hJ : J ≤ 1) :
    conductorLine J 1 = 1 := by
  simp only [conductorLine,spanSingleton_one]
  exact sup_eq_left.mpr hJ

/-- A unit residue lift generates the overorder after extension. -/
theorem conductorLine_mul_overorder (T J : FractionalIdeal R⁰ F)
    (hT : 1 ≤ T) (hTT : T*T=T) (hJ : J ≤ 1)
    (u w : F) (hu : u ∈ T) (hw : w ∈ T) (huw : u*w-1 ∈ J) :
    conductorLine J u * T = T := by
  have hline : conductorLine J u ≤ T :=
    sup_le (spanSingleton_le_iff_mem.mpr hu) (hJ.trans hT)
  have hgen : u ∈ conductorLine J u := generator_mem_conductorLine J u
  have hdiff : u*w-1 ∈ conductorLine J u := conductor_le_conductorLine J u huw
  have hprod : u*w ∈ conductorLine J u*T := mul_mem_mul hgen hw
  have hdiffprod : u*w-1 ∈ conductorLine J u*T := by
    simpa using mul_mem_mul hdiff (one_le.mp hT)
  have hone : 1 ≤ conductorLine J u*T := by
    apply one_le.mpr
    have hh := ((conductorLine J u*T : FractionalIdeal R⁰ F) : Submodule R F).sub_mem hprod hdiffprod
    convert hh using 1
    ring
  apply le_antisymm
  · calc
      conductorLine J u*T ≤ T*T := mul_le_mul_left hline T
      _ = T := hTT
  · calc
      T = 1*T := (one_mul T).symm
      _ ≤ (conductorLine J u*T)*T := mul_le_mul_left hone T
      _ = conductorLine J u*T := by rw [mul_assoc,hTT]

/-- The line multiplication is exact on residue units. -/
theorem conductorLine_mul (T J : FractionalIdeal R⁰ F)
    (hT : 1 ≤ T) (hTT : T*T=T) (hJ : J ≤ 1) (hTJ : T*J=J)
    (u w v : F) (hu : u ∈ T) (hw : w ∈ T) (hv : v ∈ T) (huw : u*w-1 ∈ J) :
    conductorLine J u * conductorLine J v = conductorLine J (u*v) := by
  have hext := conductorLine_mul_overorder T J hT hTT hJ u w hu hw huw
  have hlineJ : conductorLine J u*J=J := by
    calc
      conductorLine J u*J = conductorLine J u*(T*J) := by rw [hTJ]
      _ = (conductorLine J u*T)*J := (mul_assoc _ _ _).symm
      _ = J := by rw [hext,hTJ]
  have hJv : J*spanSingleton R⁰ v ≤ J := by
    calc
      J*spanSingleton R⁰ v ≤ J*T := mul_le_mul_right (spanSingleton_le_iff_mem.mpr hv) J
      _ = J := by rw [mul_comm,hTJ]
  apply le_antisymm
  · change (spanSingleton R⁰ u+J)*(spanSingleton R⁰ v+J) ≤ conductorLine J (u*v)
    have hsJ : (spanSingleton R⁰ u+J)*J=J := hlineJ
    rw [mul_add,add_mul,spanSingleton_mul_spanSingleton,hsJ]
    exact sup_le (sup_le le_sup_left (hJv.trans le_sup_right)) le_sup_right
  · apply sup_le
    · apply spanSingleton_le_iff_mem.mpr
      exact mul_mem_mul (generator_mem_conductorLine J u)
        (generator_mem_conductorLine J v)
    · calc
        J = conductorLine J u*J := hlineJ.symm
        _ ≤ conductorLine J u*conductorLine J v := mul_le_mul_right (conductor_le_conductorLine J v) (conductorLine J u)

/-- Reciprocal residue lifts give a literal inverse on the original
fractional-ideal carriers. No Dedekind-domain assumption is used. -/
theorem conductorLine_mul_inverse (T J : FractionalIdeal R⁰ F)
    (hT : 1 ≤ T) (hTT : T*T=T) (hJ : J ≤ 1) (hTJ : T*J=J)
    (u v : F) (hu : u ∈ T) (hv : v ∈ T) (huv : u*v-1 ∈ J) :
    conductorLine J u * conductorLine J v = 1 := by
  rw [conductorLine_mul T J hT hTT hJ hTJ u v v hu hv hv huv,
    conductorLine_eq_of_sub_mem J (u*v) 1 huv,conductorLine_one J hJ]

/-- A lift that is already an overorder unit gives its actual principal
fractional ideal. Only the conductor stability and explicit inverse enter. -/
theorem conductorLine_eq_principal (T J : FractionalIdeal R⁰ F)
    (hJ : J ≤ 1) (hTJ : T*J=J) (u w : F) (hw : w ∈ T) (huw : u*w=1) :
    conductorLine J u = spanSingleton R⁰ u := by
  have hle : J ≤ spanSingleton R⁰ u := by
    intro x hx
    have hmul : w*x ∈ J := by
      rw [← hTJ]
      exact mul_mem_mul hw hx
    obtain ⟨r,hr⟩ := (mem_one_iff _).mp (hJ hmul)
    apply (mem_spanSingleton _).mpr
    refine ⟨r,?_⟩
    rw [Algebra.smul_def,hr]
    calc
      (w*x)*u = (u*w)*x := by ring
      _ = x := by rw [huw,one_mul]
  exact sup_eq_left.mpr hle

end FractionalIdeal

namespace BinaryNormIdeal

variable (a b c : ℤ) [IsDomain (CoefficientOrder a b c)]

/-- The actual maximal order as a subalgebra of the same original field. -/
noncomputable def maximalOrderSubalgebra :
    Subalgebra (CoefficientOrder a b c) (FractionRing (CoefficientOrder a b c)) where
  carrier := Set.range (algebraMap (NumberField.RingOfIntegers
    (FractionRing (CoefficientOrder a b c))) (FractionRing (CoefficientOrder a b c)))
  zero_mem' := ⟨0,map_zero _⟩
  one_mem' := ⟨1,map_one _⟩
  add_mem' := by rintro x y ⟨u,rfl⟩ ⟨v,rfl⟩; exact ⟨u+v,map_add _ _ _⟩
  mul_mem' := by rintro x y ⟨u,rfl⟩ ⟨v,rfl⟩; exact ⟨u*v,map_mul _ _ _⟩
  algebraMap_mem' r := ⟨orderToRingOfIntegers a b c r,rfl⟩

/-- The already proved conductor index clears every element of the actual
maximal order into the original order. -/
theorem index_mul_mem_orderImage (hD : b^2-4*a*c < 0)
    (z : NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c))) :
    (orderIndex a b c : NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))*z ∈
      orderImage a b c :=
  (mem_orderImage_iff_int_add_index_mul a b c hD _).mpr ⟨0,z,by simp⟩

theorem maximalOrderSubalgebra_isFractional (hD : b^2-4*a*c < 0) :
    IsFractional (CoefficientOrder a b c)⁰ (maximalOrderSubalgebra a b c).toSubmodule := by
  refine ⟨(orderIndex a b c : CoefficientOrder a b c),?_,?_⟩
  · apply mem_nonZeroDivisors_iff_ne_zero.mpr
    exact_mod_cast (ne_of_gt (orderIndex_pos a b c hD))
  · rintro x ⟨z,rfl⟩
    obtain ⟨r,hr⟩ := index_mul_mem_orderImage a b c hD z
    refine ⟨r,?_⟩
    have h := congrArg (algebraMap (NumberField.RingOfIntegers
      (FractionRing (CoefficientOrder a b c))) (FractionRing (CoefficientOrder a b c))) hr
    simpa only [map_mul,map_natCast,orderToRingOfIntegers_coe,Algebra.smul_def,map_natCast] using h

/-- The actual maximal order as a fractional ideal over the original order.
It is not declared invertible over that smaller order. -/
noncomputable def maximalOrderFractionalIdeal (hD : b^2-4*a*c < 0) :
    FractionalIdeal (CoefficientOrder a b c)⁰ (FractionRing (CoefficientOrder a b c)) :=
  ⟨(maximalOrderSubalgebra a b c).toSubmodule,maximalOrderSubalgebra_isFractional a b c hD⟩

theorem mem_maximalOrderFractionalIdeal (hD : b^2-4*a*c < 0)
    (z : FractionRing (CoefficientOrder a b c)) :
    z ∈ maximalOrderFractionalIdeal a b c hD ↔
      ∃ w : NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)),
        algebraMap _ _ w=z := Iff.rfl

theorem one_le_maximalOrderFractionalIdeal (hD : b^2-4*a*c < 0) :
    1 ≤ maximalOrderFractionalIdeal a b c hD :=
  FractionalIdeal.one_le.mpr (maximalOrderSubalgebra a b c).one_mem

theorem maximalOrderFractionalIdeal_mul_self (hD : b^2-4*a*c < 0) :
    maximalOrderFractionalIdeal a b c hD * maximalOrderFractionalIdeal a b c hD =
      maximalOrderFractionalIdeal a b c hD := by
  apply le_antisymm
  · apply FractionalIdeal.mul_le.mpr
    exact fun _ hx _ hy => (maximalOrderSubalgebra a b c).mul_mem hx hy
  · intro x hx
    simpa using FractionalIdeal.mul_mem_mul hx
      (FractionalIdeal.one_le.mp (one_le_maximalOrderFractionalIdeal a b c hD))

/-- The actual conductor I*B in the original fractional-ideal carrier. -/
noncomputable def conductorFractionalIdeal (hD : b^2-4*a*c < 0) :
    FractionalIdeal (CoefficientOrder a b c)⁰ (FractionRing (CoefficientOrder a b c)) :=
  FractionalIdeal.spanSingleton _ (orderIndex a b c : FractionRing (CoefficientOrder a b c)) *
    maximalOrderFractionalIdeal a b c hD

theorem conductorFractionalIdeal_le_one (hD : b^2-4*a*c < 0) :
    conductorFractionalIdeal a b c hD ≤ 1 := by
  apply FractionalIdeal.spanSingleton_mul_le_iff.mpr
  intro x hx
  obtain ⟨z,rfl⟩ := (mem_maximalOrderFractionalIdeal a b c hD x).mp hx
  obtain ⟨r,hr⟩ := index_mul_mem_orderImage a b c hD z
  apply (FractionalIdeal.mem_one_iff _).mpr
  refine ⟨r,?_⟩
  have h := congrArg (algebraMap (NumberField.RingOfIntegers
    (FractionRing (CoefficientOrder a b c))) (FractionRing (CoefficientOrder a b c))) hr
  simpa only [map_mul,map_natCast,orderToRingOfIntegers_coe] using h

/-- The fractional conductor has the literal conductor carrier in B. -/
theorem mem_conductorFractionalIdeal_iff (hD : b^2-4*a*c < 0)
    (z : NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c))) :
    algebraMap _ _ z ∈ conductorFractionalIdeal a b c hD ↔ z ∈ orderConductor a b c := by
  rw [orderConductor_eq_span_index a b c hD,Ideal.mem_span_singleton]
  change algebraMap _ _ z ∈ FractionalIdeal.spanSingleton _
    (orderIndex a b c : FractionRing (CoefficientOrder a b c)) *
      maximalOrderFractionalIdeal a b c hD ↔ _
  rw [FractionalIdeal.mem_singleton_mul]
  constructor
  · rintro ⟨x,hx,hz⟩
    obtain ⟨w,rfl⟩ := (mem_maximalOrderFractionalIdeal a b c hD x).mp hx
    refine ⟨w,?_⟩
    apply Subtype.ext
    simpa only [map_mul,map_natCast] using hz
  · rintro ⟨w,hw⟩
    refine ⟨algebraMap _ _ w,⟨w,rfl⟩,?_⟩
    have h := congrArg (algebraMap (NumberField.RingOfIntegers
      (FractionRing (CoefficientOrder a b c))) (FractionRing (CoefficientOrder a b c))) hw
    simpa only [map_mul,map_natCast] using h

theorem maximalOrderFractionalIdeal_mul_conductor (hD : b^2-4*a*c < 0) :
    maximalOrderFractionalIdeal a b c hD * conductorFractionalIdeal a b c hD =
      conductorFractionalIdeal a b c hD := by
  unfold conductorFractionalIdeal
  rw [mul_left_comm, maximalOrderFractionalIdeal_mul_self a b c hD]

/-- The connecting ideal is literally A*u+I*B in the original fraction field. -/
noncomputable def conductorConnectingIdeal (hD : b^2-4*a*c < 0)
    (u : NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c))) :
    FractionalIdeal (CoefficientOrder a b c)⁰ (FractionRing (CoefficientOrder a b c)) :=
  FractionalIdeal.conductorLine (conductorFractionalIdeal a b c hD) (algebraMap _ _ u)

theorem mem_conductorConnectingIdeal (hD : b^2-4*a*c < 0)
    (u : NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))
    (x : FractionRing (CoefficientOrder a b c)) :
    x ∈ conductorConnectingIdeal a b c hD u ↔
      ∃ r : CoefficientOrder a b c,
      ∃ w : NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)),
        x = algebraMap _ _ r * algebraMap _ _ u +
          (orderIndex a b c : FractionRing (CoefficientOrder a b c))*algebraMap _ _ w := by
  change x ∈ FractionalIdeal.spanSingleton _ (algebraMap _ _ u) +
    (FractionalIdeal.spanSingleton _ (orderIndex a b c : FractionRing (CoefficientOrder a b c)) *
      maximalOrderFractionalIdeal a b c hD) ↔ _
  rw [FractionalIdeal.mem_add]
  constructor
  · rintro ⟨s,hs,t,ht,hx⟩
    obtain ⟨r,hr⟩ := (FractionalIdeal.mem_spanSingleton _).mp hs
    obtain ⟨y,hy,ht⟩ := FractionalIdeal.mem_singleton_mul.mp ht
    obtain ⟨w,rfl⟩ := (mem_maximalOrderFractionalIdeal a b c hD y).mp hy
    refine ⟨r,w,?_⟩
    simpa only [← hr,ht,Algebra.smul_def] using hx.symm
  · rintro ⟨r,w,rfl⟩
    refine ⟨algebraMap _ _ r*algebraMap _ _ u,?_,
      (orderIndex a b c : FractionRing (CoefficientOrder a b c))*algebraMap _ _ w,?_,rfl⟩
    · exact (FractionalIdeal.mem_spanSingleton _).mpr ⟨r,Algebra.smul_def ..⟩
    · exact FractionalIdeal.mem_singleton_mul.mpr ⟨algebraMap _ _ w,⟨w,rfl⟩,rfl⟩

/-- Changing a lift by the actual conductor leaves the ideal itself equal. -/
theorem conductorConnectingIdeal_eq_of_sub_mem (hD : b^2-4*a*c < 0)
    (u v : NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))
    (h : u-v ∈ orderConductor a b c) :
    conductorConnectingIdeal a b c hD u = conductorConnectingIdeal a b c hD v := by
  apply FractionalIdeal.conductorLine_eq_of_sub_mem
  simpa only [map_sub] using (mem_conductorFractionalIdeal_iff a b c hD (u-v)).mpr h

theorem conductorConnectingIdeal_one (hD : b^2-4*a*c < 0) :
    conductorConnectingIdeal a b c hD 1 = 1 := by
  change FractionalIdeal.conductorLine _ (algebraMap _ _ 1) = _
  rw [map_one,FractionalIdeal.conductorLine_one _ (conductorFractionalIdeal_le_one a b c hD)]

/-- Actual reciprocal residues give literal inverse fractional ideals. -/
theorem conductorConnectingIdeal_mul_inverse (hD : b^2-4*a*c < 0)
    (u v : NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))
    (h : u*v-1 ∈ orderConductor a b c) :
    conductorConnectingIdeal a b c hD u * conductorConnectingIdeal a b c hD v = 1 := by
  apply FractionalIdeal.conductorLine_mul_inverse (maximalOrderFractionalIdeal a b c hD) _
    (one_le_maximalOrderFractionalIdeal a b c hD)
    (maximalOrderFractionalIdeal_mul_self a b c hD)
    (conductorFractionalIdeal_le_one a b c hD)
    (maximalOrderFractionalIdeal_mul_conductor a b c hD)
    _ _ ⟨u,rfl⟩ ⟨v,rfl⟩
  simpa only [map_sub,map_mul,map_one] using
    (mem_conductorFractionalIdeal_iff a b c hD (u*v-1)).mpr h

/-- The explicit inverse uses the chosen inverse residue lift itself. -/
noncomputable def conductorConnectingIdealUnit (hD : b^2-4*a*c < 0)
    (u v : NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))
    (h : u*v-1 ∈ orderConductor a b c) :
    (FractionalIdeal (CoefficientOrder a b c)⁰ (FractionRing (CoefficientOrder a b c)))ˣ where
  val := conductorConnectingIdeal a b c hD u
  inv := conductorConnectingIdeal a b c hD v
  val_inv := conductorConnectingIdeal_mul_inverse a b c hD u v h
  inv_val := (mul_comm (conductorConnectingIdeal a b c hD v)
    (conductorConnectingIdeal a b c hD u)).trans
      (conductorConnectingIdeal_mul_inverse a b c hD u v h)

theorem conductorConnectingIdeal_inverse_eq (hD : b^2-4*a*c < 0)
    (u v : NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))
    (h : u*v-1 ∈ orderConductor a b c) :
    conductorConnectingIdeal a b c hD v = (conductorConnectingIdeal a b c hD u)⁻¹ :=
  FractionalIdeal.right_inverse_eq _ _ _ (conductorConnectingIdeal_mul_inverse a b c hD u v h)

/-- Multiplication of residue lines is exact multiplication of actual ideals. -/
theorem conductorConnectingIdeal_mul (hD : b^2-4*a*c < 0)
    (u w v : NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))
    (h : u*w-1 ∈ orderConductor a b c) :
    conductorConnectingIdeal a b c hD u * conductorConnectingIdeal a b c hD v =
      conductorConnectingIdeal a b c hD (u*v) := by
  change FractionalIdeal.conductorLine _ _ * FractionalIdeal.conductorLine _ _ =
    FractionalIdeal.conductorLine _ (algebraMap _ _ (u*v))
  rw [map_mul]
  apply FractionalIdeal.conductorLine_mul (maximalOrderFractionalIdeal a b c hD) _
    (one_le_maximalOrderFractionalIdeal a b c hD)
    (maximalOrderFractionalIdeal_mul_self a b c hD)
    (conductorFractionalIdeal_le_one a b c hD)
    (maximalOrderFractionalIdeal_mul_conductor a b c hD)
    _ _ _ ⟨u,rfl⟩ ⟨w,rfl⟩ ⟨v,rfl⟩
  simpa only [map_sub,map_mul,map_one] using
    (mem_conductorFractionalIdeal_iff a b c hD (u*w-1)).mpr h

/-- Units in the literal conductor residue ring, including the zero ring
when the actual conductor index is one. -/
abbrev ConductorResidueUnits :=
  (NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)) ⧸ orderConductor a b c)ˣ

/-- A chosen lift in the actual maximal order, never in a substitute field. -/
noncomputable def conductorResidueLift (q : ConductorResidueUnits a b c) :
    NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)) :=
  Quotient.out q.val

theorem mk_conductorResidueLift (q : ConductorResidueUnits a b c) :
    Ideal.Quotient.mk (orderConductor a b c) (conductorResidueLift a b c q) = q.val :=
  Ideal.Quotient.mk_out _

/-- The chosen inverse residue gives the actual conductor membership needed
by the proved inverse construction. -/
theorem conductorResidueLift_mul_inv_sub_mem (q : ConductorResidueUnits a b c) :
    conductorResidueLift a b c q * conductorResidueLift a b c q⁻¹ - 1 ∈ orderConductor a b c := by
  apply (Ideal.Quotient.mk_eq_one_iff_sub_mem _).mp
  rw [map_mul,mk_conductorResidueLift,mk_conductorResidueLift]
  simp

/-- Every actual residue unit gives an actual fractional-ideal unit, with
the inverse residue lift supplying its displayed inverse. -/
noncomputable def residueConnectingIdealUnit (hD : b^2-4*a*c < 0)
    (q : ConductorResidueUnits a b c) :
    (FractionalIdeal (CoefficientOrder a b c)⁰ (FractionRing (CoefficientOrder a b c)))ˣ :=
  conductorConnectingIdealUnit a b c hD (conductorResidueLift a b c q)
    (conductorResidueLift a b c q⁻¹) (conductorResidueLift_mul_inv_sub_mem a b c q)

/-- The inverse construction descends multiplicatively from residue lifts;
this is an actual ideal homomorphism before passing to classes. -/
noncomputable def residueConnectingIdealHom (hD : b^2-4*a*c < 0) :
    ConductorResidueUnits a b c →*
      (FractionalIdeal (CoefficientOrder a b c)⁰ (FractionRing (CoefficientOrder a b c)))ˣ where
  toFun := residueConnectingIdealUnit a b c hD
  map_one' := by
    apply Units.ext
    change conductorConnectingIdeal a b c hD (conductorResidueLift a b c 1)=1
    rw [← conductorConnectingIdeal_one a b c hD]
    apply conductorConnectingIdeal_eq_of_sub_mem
    apply Ideal.Quotient.eq.mp
    rw [mk_conductorResidueLift,map_one]
    rfl
  map_mul' q r := by
    apply Units.ext
    change conductorConnectingIdeal a b c hD (conductorResidueLift a b c (q*r)) =
      conductorConnectingIdeal a b c hD (conductorResidueLift a b c q) *
        conductorConnectingIdeal a b c hD (conductorResidueLift a b c r)
    rw [conductorConnectingIdeal_mul a b c hD _ _ _
      (conductorResidueLift_mul_inv_sub_mem a b c q)]
    apply conductorConnectingIdeal_eq_of_sub_mem
    apply Ideal.Quotient.eq.mp
    rw [mk_conductorResidueLift,map_mul,mk_conductorResidueLift,mk_conductorResidueLift]
    rfl

/-- The native residue connecting homomorphism into the original arbitrary-
order ClassGroup. No Dedekind-only mk0 or replacement class group is used. -/
noncomputable def conductorResidueClassHom (hD : b^2-4*a*c < 0) :
    ConductorResidueUnits a b c →* ClassGroup (CoefficientOrder a b c) :=
  (ClassGroup.mk (FractionRing (CoefficientOrder a b c))).comp (residueConnectingIdealHom a b c hD)

/-- The actual connecting ideal becomes the whole maximal order under
extension. This assertion precedes any ClassGroup extension map. -/
theorem residueConnectingIdeal_mul_maximalOrder (hD : b^2-4*a*c < 0)
    (q : ConductorResidueUnits a b c) :
    (residueConnectingIdealUnit a b c hD q :
      FractionalIdeal (CoefficientOrder a b c)⁰ (FractionRing (CoefficientOrder a b c))) *
        maximalOrderFractionalIdeal a b c hD = maximalOrderFractionalIdeal a b c hD := by
  apply FractionalIdeal.conductorLine_mul_overorder _ _
    (one_le_maximalOrderFractionalIdeal a b c hD)
    (maximalOrderFractionalIdeal_mul_self a b c hD)
    (conductorFractionalIdeal_le_one a b c hD)
    _ (algebraMap _ _ (conductorResidueLift a b c q⁻¹)) ⟨_,rfl⟩ ⟨_,rfl⟩
  simpa only [map_sub,map_mul,map_one] using
    (mem_conductorFractionalIdeal_iff a b c hD _).mpr
      (conductorResidueLift_mul_inv_sub_mem a b c q)

/-- Original-order lines of actual maximal-order units are principal in the
original field, with the same unit as generator. -/
theorem conductorConnectingIdeal_of_integerUnit (hD : b^2-4*a*c < 0)
    (u : (NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))ˣ) :
    conductorConnectingIdeal a b c hD u.val =
      FractionalIdeal.spanSingleton _ (algebraMap _ _ u.val) := by
  apply FractionalIdeal.conductorLine_eq_principal (maximalOrderFractionalIdeal a b c hD) _
    (conductorFractionalIdeal_le_one a b c hD)
    (maximalOrderFractionalIdeal_mul_conductor a b c hD)
    _ (algebraMap _ _ u⁻¹.val) ⟨_,rfl⟩
  rw [← map_mul]
  simp

/-- Maximal-order units map into the kernel of the actual residue-to-class
homomorphism. No converse or Picard exactness is asserted here. -/
theorem conductorResidueClassHom_integerUnit (hD : b^2-4*a*c < 0)
    (u : (NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))ˣ) :
    conductorResidueClassHom a b c hD
      (Units.map (Ideal.Quotient.mk (orderConductor a b c)).toMonoidHom u) = 1 := by
  change ClassGroup.mk _ (residueConnectingIdealUnit a b c hD _) = 1
  apply ClassGroup.mk_eq_one_iff.mpr
  change (conductorConnectingIdeal a b c hD (conductorResidueLift a b c _) :
    Submodule (CoefficientOrder a b c) (FractionRing (CoefficientOrder a b c))).IsPrincipal
  have heq : conductorConnectingIdeal a b c hD (conductorResidueLift a b c
      (Units.map (Ideal.Quotient.mk (orderConductor a b c)).toMonoidHom u)) =
        conductorConnectingIdeal a b c hD u.val := by
    apply conductorConnectingIdeal_eq_of_sub_mem
    apply Ideal.Quotient.eq.mp
    rw [mk_conductorResidueLift]
    rfl
  rw [heq,conductorConnectingIdeal_of_integerUnit a b c hD u]
  rw [FractionalIdeal.coe_spanSingleton]
  exact ⟨⟨_,rfl⟩⟩

end BinaryNormIdeal

namespace PositiveDefiniteIntegralLattice

/-- The conductor residue connecting homomorphism for the actual order
attached to K's original primitive discriminant. -/
noncomputable def binaryConductorResidueClassHom (K : PositiveDefiniteIntegralLattice 2) :
    letI := K.binaryDiscriminantOrder_isDomain
    BinaryNormIdeal.ConductorResidueUnits 1 (K.binaryPrimitiveDiscriminant%2)
      (((K.binaryPrimitiveDiscriminant%2)^2-K.binaryPrimitiveDiscriminant)/4) →*
        ClassGroup (BinaryNormIdeal.DiscriminantOrder K.binaryPrimitiveDiscriminant) := by
  letI := K.binaryDiscriminantOrder_isDomain
  exact BinaryNormIdeal.conductorResidueClassHom _ _ _ K.binaryDiscriminantOrder_discriminant_neg

end PositiveDefiniteIntegralLattice

