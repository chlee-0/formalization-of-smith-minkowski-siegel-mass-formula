import SMSFormula.QuadraticCartanDieudonneOrthogonal
import Mathlib.LinearAlgebra.QuadraticForm.Prod

/-!
# Intrinsic quadratic decomposition at an anisotropic vector

For an anisotropic vector `x`, the existing Cartan--Dieudonne infrastructure
splits the ambient module linearly as the line through `x` plus its polar
orthogonal complement.  This file supplies the missing quadratic refinement.

The scalar coordinate on the anisotropic line is the canonical map
`a ↦ a • x`.  Combining it with the existing complementary-submodule
equivalence gives a quadratic isometry

`x⊥ × K ≃q M`,

where the scalar factor carries the one-dimensional form `a ↦ Q (a • x)`.
No basis of the orthogonal complement, coordinate chart, or representative-
valued section is chosen.
-/

noncomputable section

namespace QuadraticMap

variable {K M : Type*} [Field K] [CharZero K]
variable [AddCommGroup M] [Module K M]
variable (Q : QuadraticForm K M)

/-- The canonical scalar parametrization `a ↦ a • x` of the line through
`x`, with codomain restricted to that line. -/
def anisotropicScalarLineLinearMap (x : M) : K →ₗ[K] K ∙ x where
  toFun a := ⟨a • x, Submodule.smul_mem _ a (Submodule.mem_span_singleton_self x)⟩
  map_add' a b := Subtype.ext (add_smul a b x)
  map_smul' a b := Subtype.ext (mul_smul a b x)

omit [CharZero K] in
@[simp]
theorem coe_anisotropicScalarLineLinearMap (x : M) (a : K) :
    (anisotropicScalarLineLinearMap (K := K) x a : M) = a • x :=
  rfl

omit [CharZero K] in
theorem anisotropicScalarLineLinearMap_bijective (x : M) (hx : x ≠ 0) :
    Function.Bijective (anisotropicScalarLineLinearMap (K := K) x) := by
  constructor
  · intro a b hab
    have hab' : a • x = b • x := congrArg Subtype.val hab
    have hzero : (a - b) • x = 0 := by
      rw [sub_smul, hab', sub_self]
    exact sub_eq_zero.mp ((smul_eq_zero.mp hzero).resolve_right hx)
  · intro y
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp y.property
    refine ⟨a, Subtype.ext ?_⟩
    exact ha

/-- The line through a nonzero `x`, canonically parametrized by its scalar
coefficient relative to `x` itself. -/
def anisotropicScalarLineEquiv (x : M) (hx : x ≠ 0) : K ≃ₗ[K] K ∙ x :=
  LinearEquiv.ofBijective (anisotropicScalarLineLinearMap (K := K) x)
    (anisotropicScalarLineLinearMap_bijective (K := K) x hx)

omit [CharZero K] in
@[simp]
theorem coe_anisotropicScalarLineEquiv (x : M) (hx : x ≠ 0) (a : K) :
    (anisotropicScalarLineEquiv (K := K) x hx a : M) = a • x :=
  rfl

/-- The one-dimensional quadratic form carried by the line through `x`,
written in its canonical scalar coordinate. -/
def anisotropicScalarLine (x : M) : QuadraticForm K K :=
  Q.comp ((LinearMap.id (R := K) (M := K)).smulRight x)

omit [CharZero K] in
@[simp]
theorem anisotropicScalarLine_apply (x : M) (a : K) :
    Q.anisotropicScalarLine x a = Q (a • x) :=
  rfl

omit [CharZero K] in
theorem anisotropicScalarLine_apply_eq_sq_mul (x : M) (a : K) :
    Q.anisotropicScalarLine x a = a ^ 2 * Q x := by
  rw [Q.anisotropicScalarLine_apply x a, QuadraticMap.map_smul]
  simp only [smul_eq_mul, pow_two]

/-- The intrinsic orthogonal-sum quadratic form at `x`: the restricted form
on `x⊥`, followed by the scalar norm line generated by `x`. -/
def anisotropicOrthogonalSum (x : M) :
    QuadraticForm K (Q.anisotropicOrthogonal x × K) :=
  (Q.orthogonalRestriction x).prod (Q.anisotropicScalarLine x)

/-- The intrinsic linear decomposition `(z, a) ↦ a • x + z`. -/
def anisotropicOrthogonalDecompositionEquiv (x : M) (hx : Q x ≠ 0) :
    (Q.anisotropicOrthogonal x × K) ≃ₗ[K] M :=
  (LinearEquiv.prodComm K (Q.anisotropicOrthogonal x) K).trans
    ((LinearEquiv.prodCongr
      (anisotropicScalarLineEquiv (K := K) x (fun h => hx (h ▸ Q.map_zero)))
      (LinearEquiv.refl K (Q.anisotropicOrthogonal x))).trans
      (Q.anisotropicDecompositionEquiv x hx))

@[simp]
theorem anisotropicOrthogonalDecompositionEquiv_apply
    (x : M) (hx : Q x ≠ 0) (z : Q.anisotropicOrthogonal x) (a : K) :
    Q.anisotropicOrthogonalDecompositionEquiv x hx (z, a) = a • x + z := by
  simp [anisotropicOrthogonalDecompositionEquiv,
    coe_anisotropicScalarLineEquiv]

/-- The intrinsic quadratic isometry
`x⊥ orthogonal_sum <Q(x)> ≃q M` at an anisotropic vector. -/
def anisotropicOrthogonalDecompositionIsometryEquiv
    (x : M) (hx : Q x ≠ 0) :
    (Q.anisotropicOrthogonalSum x).IsometryEquiv Q where
  toLinearEquiv := Q.anisotropicOrthogonalDecompositionEquiv x hx
  map_app' p := by
    rcases p with ⟨z, a⟩
    change
      Q (Q.anisotropicOrthogonalDecompositionEquiv x hx (z, a)) =
        Q.orthogonalRestriction x z + Q.anisotropicScalarLine x a
    rw [anisotropicOrthogonalDecompositionEquiv_apply,
      orthogonalRestriction_apply, anisotropicScalarLine_apply]
    rw [QuadraticMap.map_add Q]
    have hz : Q.associated.IsOrtho (a • x) z :=
      z.property (a • x)
        (Submodule.smul_mem _ a (Submodule.mem_span_singleton_self x))
    have hOrtho : Q.IsOrtho (a • x) z :=
      Q.associated_isOrtho.mp hz
    rw [hOrtho.polar_eq_zero]
    abel

@[simp]
theorem anisotropicOrthogonalDecompositionIsometryEquiv_apply
    (x : M) (hx : Q x ≠ 0) (z : Q.anisotropicOrthogonal x) (a : K) :
    Q.anisotropicOrthogonalDecompositionIsometryEquiv x hx (z, a) =
      a • x + z := by
  exact Q.anisotropicOrthogonalDecompositionEquiv_apply x hx z a

end QuadraticMap
