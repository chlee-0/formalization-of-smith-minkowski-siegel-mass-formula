import SMSFormula.RationalCliffordSpinCandidateAdelicGeneralSpinQuotientExactness
import SMSFormula.RationalCliffordSpinCandidateOnoRelativeTamagawaData

/-!
# Push the raw Spin quotient measure into the general-Spin quotient

The literal raw Spin quotient measure is pushed through the continuous
inclusion into `GSpin(Q)\GSpin(A)`.  Its total mass remains the existing raw
Spin Tamagawa number, and it is supported on the neutral rational idele-class
fiber identified by the completed quotient exactness theorem.
-/

noncomputable section

open MeasureTheory
open PositiveDefiniteIntegralLattice

namespace RationalQuadraticSpaceMatrix

variable {n : ℕ} (V : RationalQuadraticSpaceMatrix n)

/-- The full-adelic intrinsic general-Spin carrier uses its finite-coordinate
Borel measurable structure. -/
instance fullAdelicCliffordGeneralSpinGroupMeasurableSpace :
    MeasurableSpace V.FullAdelicCliffordGeneralSpinGroup :=
  borel V.FullAdelicCliffordGeneralSpinGroup

instance fullAdelicCliffordGeneralSpinGroupBorelSpace :
    BorelSpace V.FullAdelicCliffordGeneralSpinGroup :=
  ⟨rfl⟩

/-- The measurable structure generated by the rational general-Spin left
quotient map. -/
instance fullAdelicCliffordGeneralSpinLeftQuotientMeasurableSpace :
    MeasurableSpace V.FullAdelicCliffordGeneralSpinLeftQuotient :=
  MeasurableSpace.map V.fullAdelicCliffordGeneralSpinLeftQuotientMap
    (borel V.FullAdelicCliffordGeneralSpinGroup)

theorem fullAdelicCliffordGeneralSpinLeftQuotientMap_measurable :
    Measurable V.fullAdelicCliffordGeneralSpinLeftQuotientMap :=
  leftCosetMap_measurable_map
    V.rationalCliffordGeneralSpinFullAdelicDiagonalSubgroup

/-- The Spin-to-general-Spin quotient map is measurable for the literal
map-generated quotient structures. -/
theorem fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpin_measurable :
    Measurable V.fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpin := by
  rw [measurable_iff_comap_le]
  refine MeasurableSpace.comap_le_iff_le_map.mp ?_
  have hrep : Measurable
      (fun x : V.FullAdelicCliffordSpinCandidateGroup =>
        V.fullAdelicCliffordGeneralSpinLeftQuotientMap
          (V.fullAdelicCliffordSpinCandidateToGeneralSpinHom x)) :=
    V.fullAdelicCliffordGeneralSpinLeftQuotientMap_measurable.comp
      (V.continuous_cliffordSpinCandidateToCliffordGeneralSpinHom
        RationalAdele).measurable
  simpa [fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpin,
    Function.comp_def] using measurable_iff_comap_le.mp hrep

/-- Push any measure on the represented Spin quotient into the rational
adelic intrinsic general-Spin quotient. -/
def fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpinPushforward
    (μ : Measure V.FullAdelicCliffordSpinCandidateLeftQuotient) :
    Measure V.FullAdelicCliffordGeneralSpinLeftQuotient :=
  Measure.map V.fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpin μ

@[simp]
theorem fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpinPushforward_univ
    (μ : Measure V.FullAdelicCliffordSpinCandidateLeftQuotient) :
    V.fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpinPushforward μ
        Set.univ = μ Set.univ := by
  rw [fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpinPushforward,
    Measure.map_apply_of_aemeasurable
      V.fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpin_measurable.aemeasurable
      MeasurableSet.univ]
  simp

/-- The pushed measure vanishes on measurable sets disjoint from the
represented Spin image. -/
theorem fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpinPushforward_apply_eq_zero_of_disjoint_range
    (μ : Measure V.FullAdelicCliffordSpinCandidateLeftQuotient)
    {s : Set V.FullAdelicCliffordGeneralSpinLeftQuotient}
    (hs : MeasurableSet s)
    (hdisj : Disjoint s
      (Set.range V.fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpin)) :
    V.fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpinPushforward μ s = 0 := by
  rw [fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpinPushforward,
    Measure.map_apply_of_aemeasurable
      V.fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpin_measurable.aemeasurable hs]
  have hempty :
      V.fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpin ⁻¹' s = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.2
    intro x hx
    exact Set.disjoint_left.1 hdisj hx ⟨x, rfl⟩
  rw [hempty, measure_empty]

namespace CliffordSpinCandidateRawOnoTamagawaData

/-- The actual raw Spin quotient measure on the crossed general-Spin
quotient carrier. -/
def spinGeneralSpinQuotientPushforwardMeasure
    (D : V.CliffordSpinCandidateRawOnoTamagawaData) :
    Measure V.FullAdelicCliffordGeneralSpinLeftQuotient :=
  V.fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpinPushforward
    D.spinData.quotientMeasure

@[simp]
theorem spinGeneralSpinQuotientPushforwardMeasure_univ
    (D : V.CliffordSpinCandidateRawOnoTamagawaData) :
    spinGeneralSpinQuotientPushforwardMeasure V D Set.univ =
      D.spinTamagawaNumberENNReal := by
  rw [spinGeneralSpinQuotientPushforwardMeasure,
    V.fullAdelicCliffordSpinCandidateLeftQuotientToGeneralSpinPushforward_univ]
  rfl

end CliffordSpinCandidateRawOnoTamagawaData

end RationalQuadraticSpaceMatrix
