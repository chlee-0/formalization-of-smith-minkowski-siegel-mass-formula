import SMSFormula.QuadraticIsometryBaseChange
import SMSFormula.RationalQuadraticSpaceAnisotropicDecomposition

/-!
# Scalar extension of the intrinsic anisotropic decomposition

The intrinsic rational isometry at an anisotropic vector is extended to every
commutative rational algebra on the native tensor-product carrier.  Composing
only on the ambient side with the repository's existing coordinate
equivalence gives a canonical isometry into `Fin n → A`.

This yields an exact equivalence between the abstract base-changed shell and
the native ambient coordinate shell.  The orthogonal complement remains an
intrinsic submodule: no basis or `Fin (n-1)` presentation is selected, and no
measure is transported here.
-/

noncomputable section

namespace RationalQuadraticSpaceMatrix

variable {n : ℕ}

/-- The scalar extension of the intrinsic orthogonal-sum form at `x`. -/
abbrev anisotropicRationalOrthogonalSumBaseChange
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ)
    (A : Type*) [CommRing A] [Algebra ℚ A] :
    QuadraticForm A
      (TensorProduct ℚ A (V.anisotropicRationalOrthogonalComplement x × ℚ)) :=
  (V.anisotropicRationalOrthogonalSum x).baseChange A

/-- Scalar extension of the intrinsic decomposition, followed by the already
existing ambient coordinate realization. -/
def anisotropicRationalDecompositionBaseChangeIsometryEquiv
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ)
    (hx : V.nativeRationalQuadraticForm x ≠ 0)
    (A : Type*) [CommRing A] [Algebra ℚ A] :
    (V.anisotropicRationalOrthogonalSumBaseChange x A).IsometryEquiv
      (V.commutativeScalarExtensionQuadraticForm A) := by
  letI : Invertible (2 : A) := rationalAlgebraInvertibleTwo A
  exact
    (V.anisotropicRationalDecompositionIsometryEquiv x hx
      |>.baseChange (A := A)).trans
      (V.commutativeScalarExtensionQuadraticIsometryEquiv A)

@[simp]
theorem anisotropicRationalDecompositionBaseChangeIsometryEquiv_tmul
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ)
    (hx : V.nativeRationalQuadraticForm x ≠ 0)
    (A : Type*) [CommRing A] [Algebra ℚ A]
    (r : A) (z : V.anisotropicRationalOrthogonalComplement x) (a : ℚ) :
    V.anisotropicRationalDecompositionBaseChangeIsometryEquiv x hx A
        (r ⊗ₜ[ℚ] (z, a)) =
      commutativeScalarExtensionModuleEquiv (n := n) A
        (r ⊗ₜ[ℚ] (a • x + z)) := by
  letI : Invertible (2 : A) := rationalAlgebraInvertibleTwo A
  rw [anisotropicRationalDecompositionBaseChangeIsometryEquiv]
  change commutativeScalarExtensionModuleEquiv (n := n) A
      ((V.anisotropicRationalDecompositionIsometryEquiv x hx
        |>.baseChange (A := A)) (r ⊗ₜ[ℚ] (z, a))) = _
  rw [QuadraticMap.IsometryEquiv.baseChange_tmul]
  rw [anisotropicRationalDecompositionIsometryEquiv_apply]

/-- The canonical point on the base-changed norm line. -/
def anisotropicRationalBaseChangeNormLinePoint
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ)
    (A : Type*) [CommRing A] [Algebra ℚ A] :
    TensorProduct ℚ A
      (V.anisotropicRationalOrthogonalComplement x × ℚ) :=
  (1 : A) ⊗ₜ[ℚ] (0, 1)

@[simp]
theorem anisotropicRationalDecompositionBaseChangeIsometryEquiv_normLinePoint
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ)
    (hx : V.nativeRationalQuadraticForm x ≠ 0)
    (A : Type*) [CommRing A] [Algebra ℚ A] :
    V.anisotropicRationalDecompositionBaseChangeIsometryEquiv x hx A
        (V.anisotropicRationalBaseChangeNormLinePoint x A) =
      fun i ↦ algebraMap ℚ A (x i) := by
  letI : Invertible (2 : A) := rationalAlgebraInvertibleTwo A
  rw [anisotropicRationalBaseChangeNormLinePoint]
  rw [V.anisotropicRationalDecompositionBaseChangeIsometryEquiv_tmul x hx A]
  ext i
  change (TensorProduct.piScalarRight ℚ A A (Fin n)
    ((1 : A) ⊗ₜ[ℚ] ((1 : ℚ) • x + (0 : Fin n → ℚ)))) i = _
  rw [TensorProduct.piScalarRight_apply,
    TensorProduct.piScalarRightHom_tmul]
  simp [Algebra.smul_def]

/-- The abstract scalar-extended shell through the norm line generated by
`x`. -/
def anisotropicRationalOrthogonalSumShell
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ)
    (A : Type*) [CommRing A] [Algebra ℚ A] :
    Set (TensorProduct ℚ A
      (V.anisotropicRationalOrthogonalComplement x × ℚ)) :=
  {y | V.anisotropicRationalOrthogonalSumBaseChange x A y =
    algebraMap ℚ A (V.nativeRationalQuadraticForm x)}

/-- The native ambient coordinate shell through an anisotropic rational
vector. -/
def anisotropicRationalAmbientShell
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ)
    (A : Type*) [CommRing A] [Algebra ℚ A] :
    Set (Fin n → A) :=
  {y | V.commutativeScalarExtensionQuadraticForm A y =
    algebraMap ℚ A (V.nativeRationalQuadraticForm x)}

/-- The canonical norm-line point lies on the abstract scalar-extended
shell. -/
theorem anisotropicRationalBaseChangeNormLinePoint_mem_shell
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ)
    (hx : V.nativeRationalQuadraticForm x ≠ 0)
    (A : Type*) [CommRing A] [Algebra ℚ A] :
    V.anisotropicRationalBaseChangeNormLinePoint x A ∈
      V.anisotropicRationalOrthogonalSumShell x A := by
  letI : Invertible (2 : A) := rationalAlgebraInvertibleTwo A
  let e := V.anisotropicRationalDecompositionBaseChangeIsometryEquiv x hx A
  have hmap := e.map_app (V.anisotropicRationalBaseChangeNormLinePoint x A)
  rw [V.anisotropicRationalDecompositionBaseChangeIsometryEquiv_normLinePoint
    x hx A] at hmap
  change V.anisotropicRationalOrthogonalSumBaseChange x A
      (V.anisotropicRationalBaseChangeNormLinePoint x A) = _
  rw [← hmap]
  exact V.commutativeScalarExtensionQuadraticForm_map
    ℚ (Algebra.ofId ℚ A) x

/-- The canonical equivalence between the abstract base-changed orthogonal-
sum shell and the existing ambient coordinate shell. -/
def anisotropicRationalBaseChangeShellEquiv
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ)
    (hx : V.nativeRationalQuadraticForm x ≠ 0)
    (A : Type*) [CommRing A] [Algebra ℚ A] :
    V.anisotropicRationalOrthogonalSumShell x A ≃
      V.anisotropicRationalAmbientShell x A := by
  letI : Invertible (2 : A) := rationalAlgebraInvertibleTwo A
  let e := V.anisotropicRationalDecompositionBaseChangeIsometryEquiv x hx A
  exact
    { toFun := fun y ↦ ⟨e y, by
        change V.commutativeScalarExtensionQuadraticForm A (e y) = _
        rw [e.map_app, y.property]⟩
      invFun := fun y ↦ ⟨e.symm y, by
        change V.anisotropicRationalOrthogonalSumBaseChange x A (e.symm y) = _
        rw [e.symm.map_app, y.property]⟩
      left_inv := fun y ↦ Subtype.ext (e.symm_apply_apply y)
      right_inv := fun y ↦ Subtype.ext (e.apply_symm_apply y) }

@[simp]
theorem coe_anisotropicRationalBaseChangeShellEquiv
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ)
    (hx : V.nativeRationalQuadraticForm x ≠ 0)
    (A : Type*) [CommRing A] [Algebra ℚ A]
    (y : V.anisotropicRationalOrthogonalSumShell x A) :
    (V.anisotropicRationalBaseChangeShellEquiv x hx A y).1 =
      V.anisotropicRationalDecompositionBaseChangeIsometryEquiv x hx A y :=
  rfl

@[simp]
theorem anisotropicRationalBaseChangeShellEquiv_normLinePoint
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ)
    (hx : V.nativeRationalQuadraticForm x ≠ 0)
    (A : Type*) [CommRing A] [Algebra ℚ A] :
    (V.anisotropicRationalBaseChangeShellEquiv x hx A
      ⟨V.anisotropicRationalBaseChangeNormLinePoint x A,
        V.anisotropicRationalBaseChangeNormLinePoint_mem_shell x hx A⟩).1 =
      fun i ↦ algebraMap ℚ A (x i) :=
  V.anisotropicRationalDecompositionBaseChangeIsometryEquiv_normLinePoint
    x hx A

end RationalQuadraticSpaceMatrix
