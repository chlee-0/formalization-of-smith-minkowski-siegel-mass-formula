import SMSFormula.RationalOrthogonalPolynomialJacobian
import SMSFormula.RectangularMaximalMinors
import Mathlib.RingTheory.Localization.Away.Basic

/-!
# Maximal minors of the universal orthogonal Jacobian

The universal independent orthogonal Jacobian has an explicit rectangular
right inverse.  The rectangular determinant expansion therefore proves that
its maximal column minors generate the unit ideal in the orthogonal coordinate
ring.  Each minor is indexed by the precise injection from independent
relations to matrix variables required by
`Algebra.PreSubmersivePresentation`.

For each such injection this file also records the associated localization
away from the minor and proves that the mapped minor is a unit.
-/

noncomputable section

open scoped Matrix

namespace RationalQuadraticSpaceMatrix

variable {n : ℕ} (V : RationalQuadraticSpaceMatrix n)

/-- An injection selecting one matrix variable for each independent
orthogonality relation. -/
abbrev OrthogonalJacobianMinorIndex :=
  SpecialOrthogonalIndependentRelationIndex (n := n) ↪ (Fin n × Fin n)

/-- The maximal Jacobian minor selected by `e`. -/
def orthogonalUniversalIndependentJacobianMinor
    (e : OrthogonalJacobianMinorIndex (n := n)) :
    V.orthogonalCoordinateRing :=
  Matrix.det (V.orthogonalUniversalIndependentJacobian.submatrix id e)

/-- The ideal generated by all maximal minors of the universal independent
orthogonal Jacobian. -/
def orthogonalUniversalIndependentJacobianMinorIdeal :
    Ideal V.orthogonalCoordinateRing :=
  Matrix.maximalColumnMinorIdeal
    V.orthogonalUniversalIndependentJacobian

/-- The universal independent Jacobian maximal minors generate the unit
ideal. -/
theorem orthogonalUniversalIndependentJacobianMinorIdeal_eq_top :
    V.orthogonalUniversalIndependentJacobianMinorIdeal = ⊤ := by
  exact Matrix.maximalColumnMinorIdeal_eq_top_of_mul_eq_one
    V.orthogonalUniversalIndependentJacobian
      V.orthogonalUniversalIndependentJacobianRightInverse
        V.orthogonalUniversalIndependentJacobian_mul_rightInverse

/-- The principal-open chart ring associated with a selected universal
Jacobian minor. -/
abbrev OrthogonalJacobianMinorLocalization
    (e : OrthogonalJacobianMinorIndex (n := n)) :=
  Localization.Away (V.orthogonalUniversalIndependentJacobianMinor e)

/-- The canonical map to a maximal-minor chart. -/
abbrev orthogonalJacobianMinorLocalizationMap
    (e : OrthogonalJacobianMinorIndex (n := n)) :
    V.orthogonalCoordinateRing →+*
      OrthogonalJacobianMinorLocalization V e :=
  algebraMap V.orthogonalCoordinateRing
    (OrthogonalJacobianMinorLocalization V e)

/-- The selected Jacobian minor becomes a unit on its principal-open chart. -/
theorem orthogonalUniversalIndependentJacobianMinor_isUnit_localization
    (e : OrthogonalJacobianMinorIndex (n := n)) :
    IsUnit
      (orthogonalJacobianMinorLocalizationMap V e
        (orthogonalUniversalIndependentJacobianMinor V e)) := by
  exact IsLocalization.map_units
    (OrthogonalJacobianMinorLocalization V e)
      ⟨orthogonalUniversalIndependentJacobianMinor V e,
        Submonoid.mem_powers _⟩

end RationalQuadraticSpaceMatrix
