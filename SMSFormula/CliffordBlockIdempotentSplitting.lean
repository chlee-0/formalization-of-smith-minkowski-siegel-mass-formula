import SMSFormula.CliffordOrthogonalQuadruple
import SMSFormula.CliffordOrthogonalTriple
import Mathlib.Tactic.LinearCombination

/-!
# The idempotent splitting of the block Clifford algebra

Four pairwise orthogonal vectors `v₀, …, v₃` with `f₃ = f₀f₁f₂` (the block space `T ⊥ ⟨d⟩`, `d = f₀f₁f₂`),
`dinv · f₃ = 1`, and `2` invertible.  The ternary part is generated by `e₀, e₁, e₂`; its even span has the quaternion
coordinates of `CliffordOrthogonalTriple`.  With `θ(c) = (f₃c₃, −f₂c₂, f₁c₁, −f₀c₀)` (so `θ(v) = d v₃ − (Σ vᵢeᵢ)ν`):

`(Σ cᵢeᵢ) e₃ = θ(c) p₊ + θ̄(c) p₋` (`vector_mul_last`).
Nothing is chosen.
-/

noncomputable section

set_option linter.unusedSimpArgs false

namespace CliffordAlgebra.BlockSplitting

open OrthogonalQuadruple

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M] (Q : QuadraticForm R M)
variable (v : Fin 4 → M) (hv : ∀ i j, i ≠ j → Q.IsOrtho (v i) (v j))

/-- The ternary part of the block family. -/
def tv : Fin 3 → M := fun i ↦ v (Fin.castSucc i)

include hv in
theorem tv_ortho : ∀ i j, i ≠ j → Q.IsOrtho (tv v i) (tv v j) := fun _i _j h ↦
  hv _ _ (fun h' ↦ h (Fin.castSucc_injective _ h'))

theorem tv_apply (i : Fin 3) : tv v i = v (Fin.castSucc i) := rfl

theorem tv_zero : tv v 0 = v 0 := rfl
theorem tv_one : tv v 1 = v 1 := rfl
theorem tv_two : tv v 2 = v 2 := rfl

/-- The coordinates of `θ(c) = f₃c₃ − (c₀e₀ + c₁e₁ + c₂e₂)ν`. -/
def theta (c : Fin 4 → R) : Fin 4 → R :=
  ![Q (v 3) * c 3, -(Q (v 2) * c 2), Q (v 1) * c 1, -(Q (v 0) * c 0)]

local notation "𝔢" => OrthogonalQuadruple.gen Q v

variable {dinv : R} [Invertible (2 : R)]

omit [Invertible (2 : R)] in
/-- The quadruple volume element is the ternary one times `e₃`. -/
theorem volume_eq_triple_mul_last :
    OrthogonalQuadruple.volume Q v = OrthogonalTriple.volume Q (tv v) * 𝔢 3 := by
  unfold OrthogonalQuadruple.volume OrthogonalTriple.volume
  simp only [tv_zero, tv_one, tv_two, OrthogonalTriple.gen, mul_assoc]

/-- `X p₊ + Y p₋ = ½(X + Y) + ½(X − Y) z`. -/
theorem mul_idemPlus_add_mul_idemMinus (X Y : CliffordAlgebra Q) :
    X * idemPlus Q v dinv + Y * idemMinus Q v dinv =
      ⅟(2 : R) • (X + Y) + ⅟(2 : R) • ((X - Y) * normVolume Q v dinv) := by
  unfold idemPlus idemMinus
  simp only [mul_smul_comm, mul_add, mul_sub, mul_one, sub_mul, smul_add, smul_sub]
  abel

omit [Invertible (2 : R)] in
theorem evenElem_add_evenConj (h : Fin 4 → R) :
    OrthogonalTriple.evenElem Q (tv v) h + OrthogonalTriple.evenElem Q (tv v) (OrthogonalTriple.evenConj h) =
      algebraMap R _ (2 * h 0) := by
  unfold OrthogonalTriple.evenElem OrthogonalTriple.evenConj
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.head_cons, Matrix.tail_cons, map_mul, map_ofNat, neg_smul]
  rw [two_mul]
  abel

omit [Invertible (2 : R)] in
theorem evenElem_sub_evenConj (h : Fin 4 → R) :
    OrthogonalTriple.evenElem Q (tv v) h - OrthogonalTriple.evenElem Q (tv v) (OrthogonalTriple.evenConj h) =
      (2 : R) • OrthogonalTriple.evenElem Q (tv v) ![0, h 1, h 2, h 3] := by
  unfold OrthogonalTriple.evenElem OrthogonalTriple.evenConj
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
    Matrix.head_cons, Matrix.tail_cons, map_zero, neg_smul, Algebra.algebraMap_eq_smul_one]
  module

omit [Invertible (2 : R)] in
include hv in
/-- `ν z = −e₃` for `z = d e₀e₁e₂e₃` with `d f₀f₁f₂ = 1`. -/
theorem triple_volume_mul_normVolume (hD : Q (v 3) = Q (v 0) * Q (v 1) * Q (v 2))
    (hdinv : dinv * Q (v 3) = 1) :
    OrthogonalTriple.volume Q (tv v) * normVolume Q v dinv = -𝔢 3 := by
  have hν := OrthogonalTriple.volume_mul_volume Q (tv v) (tv_ortho Q v hv)
  simp only [tv_zero, tv_one, tv_two] at hν
  unfold normVolume
  rw [volume_eq_triple_mul_last, mul_smul_comm, ← mul_assoc, hν, neg_mul, ← Algebra.smul_def, smul_neg,
    smul_smul, ← hD, hdinv, one_smul]

/-- `p₊ − p₋ = z`. -/
theorem idemPlus_sub_idemMinus : idemPlus Q v dinv - idemMinus Q v dinv = normVolume Q v dinv := by
  unfold idemPlus idemMinus
  rw [← smul_sub, add_sub_sub_cancel, ← two_smul R, smul_smul, invOf_mul_self, one_smul]

set_option maxHeartbeats 1600000 in
include hv in
/-- The vector splitting (3.13): `(Σ cᵢeᵢ) e₃ = θ(c) p₊ + θ̄(c) p₋`. -/
theorem vector_mul_last (hD : Q (v 3) = Q (v 0) * Q (v 1) * Q (v 2)) (hdinv : dinv * Q (v 3) = 1)
    (c : Fin 4 → R) :
    (c 0 • 𝔢 0 + c 1 • 𝔢 1 + c 2 • 𝔢 2 + c 3 • 𝔢 3) * 𝔢 3 =
      OrthogonalTriple.evenElem Q (tv v) (theta Q v c) * idemPlus Q v dinv +
        OrthogonalTriple.evenElem Q (tv v) (OrthogonalTriple.evenConj (theta Q v c)) * idemMinus Q v dinv := by
  have hT := tv_ortho Q v hv
  rw [mul_idemPlus_add_mul_idemMinus, evenElem_add_evenConj, evenElem_sub_evenConj]
  -- the vector part of `θ` is `−(Σ_{i<3} cᵢeᵢ) ν`
  have hvec := OrthogonalTriple.vector_mul_volume Q (tv v) hT ![c 0, c 1, c 2]
  simp only [tv_zero, tv_one, tv_two, OrthogonalTriple.gen, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] at hvec
  have hθ : OrthogonalTriple.evenElem Q (tv v) ![0, theta Q v c 1, theta Q v c 2, theta Q v c 3] =
      -((c 0 • 𝔢 0 + c 1 • 𝔢 1 + c 2 • 𝔢 2) * OrthogonalTriple.volume Q (tv v)) := by
    rw [hvec]
    unfold OrthogonalTriple.evenElem theta
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.cons_val_three,
      Matrix.head_cons, Matrix.tail_cons, map_zero, zero_add, neg_add, neg_smul, smul_neg, neg_neg]
  rw [hθ]
  -- `ν z = dinv · ν² e₃ = −dinv f₀f₁f₂ e₃ = −e₃`
  have hν := OrthogonalTriple.volume_mul_volume Q (tv v) hT
  simp only [tv_zero, tv_one, tv_two] at hν
  have hνz : OrthogonalTriple.volume Q (tv v) * normVolume Q v dinv = -𝔢 3 := by
    unfold normVolume
    rw [volume_eq_triple_mul_last, mul_smul_comm, ← mul_assoc, hν, neg_mul, ← Algebra.smul_def, smul_neg,
      smul_smul, ← hD, hdinv, one_smul]
  simp only [smul_neg, neg_mul, smul_mul_assoc, mul_assoc, hνz, mul_neg, neg_neg, smul_smul,
    invOf_mul_self, one_smul, add_mul, smul_add]
  simp only [neg_add, neg_neg, ← mul_assoc, invOf_mul_self, one_mul]
  rw [OrthogonalQuadruple.gen_sq, theta]
  simp only [Matrix.cons_val_zero, Algebra.algebraMap_eq_smul_one, smul_smul, smul_mul_assoc, ← mul_assoc,
    invOf_mul_self, one_mul]
  module

/-! ## The block elements `Φ(h, k) = h p₊ + k p₋` -/

omit [Invertible (2 : R)] in
theorem evenElem_mem_even (h : Fin 4 → R) : OrthogonalTriple.evenElem Q (tv v) h ∈ evenOdd Q 0 := by
  unfold OrthogonalTriple.evenElem
  refine Submodule.add_mem _ (Submodule.add_mem _ (Submodule.add_mem _ ?_ ?_) ?_) ?_
  · exact SetLike.algebraMap_mem_graded _ _
  all_goals exact Submodule.smul_mem _ _ (ι_mul_ι_mem_evenOdd_zero Q _ _)

/-- The block element `Φ(h, k) = h p₊ + k p₋` in quaternion coordinates. -/
def blockElem (dinv : R) (h k : Fin 4 → R) : CliffordAlgebra Q :=
  OrthogonalTriple.evenElem Q (tv v) h * idemPlus Q v dinv +
    OrthogonalTriple.evenElem Q (tv v) k * idemMinus Q v dinv

variable (hspan : ∀ m : M, m ∈ Submodule.span R (Set.range v))

include hv hspan in
theorem evenElem_mul_idemPlus_comm (h : Fin 4 → R) :
    OrthogonalTriple.evenElem Q (tv v) h * idemPlus Q v dinv =
      idemPlus Q v dinv * OrthogonalTriple.evenElem Q (tv v) h :=
  even_mul_idemPlus Q v hv hspan (evenElem_mem_even Q v h)

include hv hspan in
theorem evenElem_mul_idemMinus_comm (h : Fin 4 → R) :
    OrthogonalTriple.evenElem Q (tv v) h * idemMinus Q v dinv =
      idemMinus Q v dinv * OrthogonalTriple.evenElem Q (tv v) h :=
  even_mul_idemMinus Q v hv hspan (evenElem_mem_even Q v h)

include hv hspan in
/-- `Φ` is multiplicative in coordinates. -/
theorem blockElem_mul (hd : Q (v 0) * Q (v 1) * Q (v 2) * Q (v 3) * (dinv * dinv) = 1)
    (h k h' k' : Fin 4 → R) :
    blockElem Q v dinv h k * blockElem Q v dinv h' k' =
      blockElem Q v dinv (OrthogonalTriple.evenMul Q (tv v) h h') (OrthogonalTriple.evenMul Q (tv v) k k') := by
  have hT := tv_ortho Q v hv
  unfold blockElem
  simp only [add_mul, mul_add, mul_assoc]
  rw [← mul_assoc (idemPlus Q v dinv), ← evenElem_mul_idemPlus_comm Q v hv hspan h',
    mul_assoc _ (idemPlus Q v dinv), idemPlus_mul_self Q v hv hd,
    ← mul_assoc (idemPlus Q v dinv) (OrthogonalTriple.evenElem Q (tv v) k'),
    ← evenElem_mul_idemPlus_comm Q v hv hspan k', mul_assoc _ (idemPlus Q v dinv),
    idemPlus_mul_idemMinus Q v hv hd,
    ← mul_assoc (idemMinus Q v dinv) (OrthogonalTriple.evenElem Q (tv v) h'),
    ← evenElem_mul_idemMinus_comm Q v hv hspan h', mul_assoc _ (idemMinus Q v dinv),
    idemMinus_mul_idemPlus Q v hv hd,
    ← mul_assoc (idemMinus Q v dinv) (OrthogonalTriple.evenElem Q (tv v) k'),
    ← evenElem_mul_idemMinus_comm Q v hv hspan k', mul_assoc _ (idemMinus Q v dinv),
    idemMinus_mul_self Q v hv hd]
  simp only [mul_zero, zero_add, add_zero, ← mul_assoc, OrthogonalTriple.evenElem_mul_evenElem Q (tv v) hT]

include hv hspan in
/-- `Φ` commutes with reversion in coordinates. -/
theorem reverse_blockElem (h k : Fin 4 → R) :
    reverse (blockElem Q v dinv h k) =
      blockElem Q v dinv (OrthogonalTriple.evenConj h) (OrthogonalTriple.evenConj k) := by
  have hT := tv_ortho Q v hv
  unfold blockElem
  rw [map_add, reverse.map_mul, reverse.map_mul, reverse_idemPlus Q v hv, reverse_idemMinus Q v hv,
    OrthogonalTriple.reverse_evenElem Q (tv v) hT, OrthogonalTriple.reverse_evenElem Q (tv v) hT,
    ← evenElem_mul_idemPlus_comm Q v hv hspan, ← evenElem_mul_idemMinus_comm Q v hv hspan]

omit [Invertible (2 : R)] in
include hv in
/-- The last generator commutes with the ternary even part. -/
theorem gen_last_mul_evenElem (h : Fin 4 → R) :
    𝔢 3 * OrthogonalTriple.evenElem Q (tv v) h = OrthogonalTriple.evenElem Q (tv v) h * 𝔢 3 := by
  unfold OrthogonalTriple.evenElem
  simp only [tv_zero, tv_one, tv_two, OrthogonalTriple.gen, mul_add, add_mul, mul_smul_comm,
    smul_mul_assoc, mul_assoc, Algebra.commutes]
  rw [← mul_assoc (𝔢 3) (𝔢 0), e30 Q v hv, neg_mul, mul_assoc, e31 Q v hv, mul_neg, neg_neg,
    ← mul_assoc (𝔢 3) (𝔢 0), e30 Q v hv, neg_mul, mul_assoc, e32 Q v hv, mul_neg, neg_neg,
    ← mul_assoc (𝔢 3) (𝔢 1), e31 Q v hv, neg_mul, mul_assoc, e32 Q v hv, mul_neg, neg_neg]

include hv in
/-- The last generator swaps the components: `Φ(h, k) e₃ = e₃ Φ(k, h)`. -/
theorem blockElem_mul_gen_last (h k : Fin 4 → R) :
    blockElem Q v dinv h k * 𝔢 3 = 𝔢 3 * blockElem Q v dinv k h := by
  unfold blockElem
  rw [add_mul, mul_assoc, mul_assoc, ← gen_mul_idemMinus Q v hv, ← gen_mul_idemPlus Q v hv, ← mul_assoc,
    ← mul_assoc, ← gen_last_mul_evenElem Q v hv, ← gen_last_mul_evenElem Q v hv, mul_assoc, mul_assoc,
    ← mul_add, add_comm]

include hv hspan in
/-- The conjugation formula (3.14): `Φ(h,k) u Φ(h,k)‾ e₃ = Φ(h θ k̄, k θ̄ h̄)`. -/
theorem blockElem_conj_vector_mul_last (hD : Q (v 3) = Q (v 0) * Q (v 1) * Q (v 2))
    (hdinv : dinv * Q (v 3) = 1) (h k c : Fin 4 → R) :
    blockElem Q v dinv h k * (c 0 • 𝔢 0 + c 1 • 𝔢 1 + c 2 • 𝔢 2 + c 3 • 𝔢 3) *
        reverse (blockElem Q v dinv h k) * 𝔢 3 =
      blockElem Q v dinv
        (OrthogonalTriple.evenMul Q (tv v) (OrthogonalTriple.evenMul Q (tv v) h (theta Q v c))
          (OrthogonalTriple.evenConj k))
        (OrthogonalTriple.evenMul Q (tv v)
          (OrthogonalTriple.evenMul Q (tv v) k (OrthogonalTriple.evenConj (theta Q v c)))
          (OrthogonalTriple.evenConj h)) := by
  have hd : Q (v 0) * Q (v 1) * Q (v 2) * Q (v 3) * (dinv * dinv) = 1 := by
    rw [← hD, show Q (v 3) * Q (v 3) * (dinv * dinv) = (dinv * Q (v 3)) * (dinv * Q (v 3)) by ring, hdinv,
      one_mul]
  rw [reverse_blockElem Q v hv hspan, mul_assoc, blockElem_mul_gen_last Q v hv, ← mul_assoc,
    mul_assoc (blockElem Q v dinv h k), vector_mul_last Q v hv hD hdinv]
  change blockElem Q v dinv h k * blockElem Q v dinv (theta Q v c) (OrthogonalTriple.evenConj (theta Q v c)) *
    blockElem Q v dinv (OrthogonalTriple.evenConj k) (OrthogonalTriple.evenConj h) = _
  rw [blockElem_mul Q v hv hspan hd, blockElem_mul Q v hv hspan hd]

/-! ## Recovering the conjugated vector -/

/-- The inverse coordinates `θ⁻¹(y) = (−y₃/f₀, y₂/f₁, −y₁/f₂, y₀/f₃)` (with supplied inverses). -/
def thetaInv (u0 u1 u2 dinv : R) (y : Fin 4 → R) : Fin 4 → R :=
  ![-(u0 * y 3), u1 * y 2, -(u2 * y 1), dinv * y 0]

omit [Invertible (2 : R)] in
theorem theta_thetaInv {u0 u1 u2 : R} (hu0 : u0 * Q (v 0) = 1) (hu1 : u1 * Q (v 1) = 1)
    (hu2 : u2 * Q (v 2) = 1) (hdinv : dinv * Q (v 3) = 1) (y : Fin 4 → R) :
    theta Q v (thetaInv u0 u1 u2 dinv y) = y := by
  funext i
  fin_cases i <;> simp [theta, thetaInv]
  · linear_combination y 0 * hdinv
  · linear_combination y 1 * hu2
  · linear_combination y 2 * hu1
  · linear_combination y 3 * hu0

omit [Invertible (2 : R)] in
/-- Conjugation reverses coordinate products: `(h θ k̄)‾ = k θ̄ h̄`. -/
theorem evenConj_evenMul_evenMul (h θ k : Fin 4 → R) :
    OrthogonalTriple.evenConj (OrthogonalTriple.evenMul Q (tv v) (OrthogonalTriple.evenMul Q (tv v) h θ)
        (OrthogonalTriple.evenConj k)) =
      OrthogonalTriple.evenMul Q (tv v) (OrthogonalTriple.evenMul Q (tv v) k (OrthogonalTriple.evenConj θ))
        (OrthogonalTriple.evenConj h) := by
  funext i
  fin_cases i <;> simp [OrthogonalTriple.evenConj, OrthogonalTriple.evenMul] <;> ring

omit [Invertible (2 : R)] in
include hv in
/-- Right cancellation of the last generator. -/
theorem eq_of_mul_gen_last_eq (hdinv : dinv * Q (v 3) = 1) {X Y : CliffordAlgebra Q}
    (h : X * 𝔢 3 = Y * 𝔢 3) : X = Y := by
  have hX : X = dinv • (X * 𝔢 3 * 𝔢 3) := by
    rw [mul_assoc, OrthogonalQuadruple.gen_sq, ← Algebra.commutes, ← Algebra.smul_def, smul_smul, hdinv,
      one_smul]
  have hY : Y = dinv • (Y * 𝔢 3 * 𝔢 3) := by
    rw [mul_assoc, OrthogonalQuadruple.gen_sq, ← Algebra.commutes, ← Algebra.smul_def, smul_smul, hdinv,
      one_smul]
  rw [hX, hY, h]

/-- The coordinates of the conjugated vector. -/
def conjCoords (dinv u0 u1 u2 : R) (h k c : Fin 4 → R) : Fin 4 → R :=
  thetaInv u0 u1 u2 dinv (OrthogonalTriple.evenMul Q (tv v)
    (OrthogonalTriple.evenMul Q (tv v) h (theta Q v c)) (OrthogonalTriple.evenConj k))

include hv hspan in
/-- The conjugated vector (3.15): `Φ(h,k) u Φ(h,k)‾ = Σ c'ᵢ eᵢ` with `θ(c') = h θ(c) k̄`. -/
theorem blockElem_conj_vector (hD : Q (v 3) = Q (v 0) * Q (v 1) * Q (v 2)) (hdinv : dinv * Q (v 3) = 1)
    {u0 u1 u2 : R} (hu0 : u0 * Q (v 0) = 1) (hu1 : u1 * Q (v 1) = 1) (hu2 : u2 * Q (v 2) = 1)
    (h k c : Fin 4 → R) :
    blockElem Q v dinv h k * (c 0 • 𝔢 0 + c 1 • 𝔢 1 + c 2 • 𝔢 2 + c 3 • 𝔢 3) *
        reverse (blockElem Q v dinv h k) =
      conjCoords Q v dinv u0 u1 u2 h k c 0 • 𝔢 0 + conjCoords Q v dinv u0 u1 u2 h k c 1 • 𝔢 1 +
        conjCoords Q v dinv u0 u1 u2 h k c 2 • 𝔢 2 + conjCoords Q v dinv u0 u1 u2 h k c 3 • 𝔢 3 := by
  apply eq_of_mul_gen_last_eq Q v hv hdinv
  rw [blockElem_conj_vector_mul_last Q v hv hspan hD hdinv, vector_mul_last Q v hv hD hdinv, conjCoords,
    theta_thetaInv Q v hu0 hu1 hu2 hdinv, evenConj_evenMul_evenMul]
  rfl

end CliffordAlgebra.BlockSplitting
