import SMSFormula.RationalCliffordSpinCandidateFiniteAdelicLocalCompactness
import SMSFormula.SpecialOrthogonalFullAdelicDifferentialMeasurableWeilQuotient
import Mathlib.MeasureTheory.Measure.Haar.Basic

/-!
# Reference Haar and quotient-measure interface for the Spin candidate

The completed adelic topology makes the full-adelic Clifford--Spin candidate
a locally compact Hausdorff topological group.  This file installs its Borel
measurable space and a reference Haar measure, and records the exact remaining
quotient-measure input as the measurable left Weil formula.

The reference Haar measure is deliberately not identified with a measure
coming from a rational invariant differential.  Likewise, no quotient measure
is fabricated merely from local compactness: a prospective quotient measure
must carry the explicit measurable Weil certificate below.
-/

noncomputable section

open MeasureTheory
open PositiveDefiniteIntegralLattice
open Set
open scoped ENNReal

namespace RationalQuadraticSpaceMatrix

variable {n : ℕ} (V : RationalQuadraticSpaceMatrix n)

/-! ## Countability and Borel structures -/

/-- The full-adelic candidate group is second countable through its finite
coordinate embedding. -/
noncomputable instance
    fullAdelicCliffordSpinCandidateGroupSecondCountableTopology :
    SecondCountableTopology V.FullAdelicCliffordSpinCandidateGroup := by
  letI : SecondCountableTopology (Finset (Fin n) → RationalAdele) :=
    TopologicalSpace.instSecondCountableTopologyForallOfCountable
  letI : SecondCountableTopology
      (Matrix (Fin n) (Fin n) RationalAdele) :=
    TopologicalSpace.instSecondCountableTopologyForallOfCountable
  exact
    (V.cliffordSpinCandidatePointCoordinateMap_isEmbedding RationalAdele)
      |>.secondCountableTopology

/-- The full-adelic candidate group uses its inherited Borel measurable
space. -/
instance fullAdelicCliffordSpinCandidateGroupMeasurableSpace :
    MeasurableSpace V.FullAdelicCliffordSpinCandidateGroup :=
  borel V.FullAdelicCliffordSpinCandidateGroup

instance fullAdelicCliffordSpinCandidateGroupBorelSpace :
    BorelSpace V.FullAdelicCliffordSpinCandidateGroup :=
  ⟨rfl⟩

/-- The quotient measurable structure generated by the rational left-quotient
map. -/
instance fullAdelicCliffordSpinCandidateLeftQuotientMeasurableSpace :
    MeasurableSpace V.FullAdelicCliffordSpinCandidateLeftQuotient :=
  MeasurableSpace.map V.fullAdelicCliffordSpinCandidateLeftQuotientMap
    (borel V.FullAdelicCliffordSpinCandidateGroup)

/-- The rational left-quotient map is measurable for the map-generated
quotient measurable space. -/
theorem fullAdelicCliffordSpinCandidateLeftQuotientMap_measurable :
    Measurable V.fullAdelicCliffordSpinCandidateLeftQuotientMap :=
  leftCosetMap_measurable_map
    V.rationalCliffordSpinCandidateFullAdelicDiagonalSubgroup

/-- Rational candidate points are countable because their finite coordinate
map is injective. -/
noncomputable instance rationalCliffordSpinCandidateGroupCountable :
    Countable V.RationalCliffordSpinCandidateGroup :=
  Function.Injective.countable
    (V.cliffordSpinCandidatePointCoordinateMap_injective ℚ)

/-- The rational diagonal subgroup of the full-adelic candidate group is
countable. -/
theorem rationalCliffordSpinCandidateFullAdelicDiagonalSubgroup_countable :
    Countable V.rationalCliffordSpinCandidateFullAdelicDiagonalSubgroup := by
  let diagonalLift :
      V.RationalCliffordSpinCandidateGroup →
        V.rationalCliffordSpinCandidateFullAdelicDiagonalSubgroup :=
    fun q =>
      ⟨V.rationalCliffordSpinCandidateFullAdelicDiagonalHom q, ⟨q, rfl⟩⟩
  apply Function.Surjective.countable (f := diagonalLift)
  intro gamma
  rcases gamma.2 with ⟨q, hq⟩
  refine ⟨q, Subtype.ext ?_⟩
  exact hq

/-! ## A reference Haar measure -/

/-- An arbitrary reference Haar measure supplied by the locally compact
Hausdorff topological-group structure.  Its scale is not the prospective
rational invariant-differential Tamagawa normalization. -/
noncomputable def fullAdelicCliffordSpinCandidateReferenceHaarMeasure :
    Measure V.FullAdelicCliffordSpinCandidateGroup :=
  Measure.haar

/-- The reference measure is a genuine left Haar measure. -/
noncomputable instance
    fullAdelicCliffordSpinCandidateReferenceHaarMeasureIsHaarMeasure :
    Measure.IsHaarMeasure
      V.fullAdelicCliffordSpinCandidateReferenceHaarMeasure := by
  unfold fullAdelicCliffordSpinCandidateReferenceHaarMeasure
  infer_instance

/-- The reference Haar measure is left invariant. -/
noncomputable instance
    fullAdelicCliffordSpinCandidateReferenceHaarMeasureIsMulLeftInvariant :
    Measure.IsMulLeftInvariant
      V.fullAdelicCliffordSpinCandidateReferenceHaarMeasure := by
  infer_instance

/-- The reference Haar measure is nonzero. -/
theorem fullAdelicCliffordSpinCandidateReferenceHaarMeasure_ne_zero :
    V.fullAdelicCliffordSpinCandidateReferenceHaarMeasure ≠ 0 := by
  intro hzero
  have huniv :
      V.fullAdelicCliffordSpinCandidateReferenceHaarMeasure Set.univ ≠ 0 :=
    isOpen_univ.measure_ne_zero
      V.fullAdelicCliffordSpinCandidateReferenceHaarMeasure Set.univ_nonempty
  rw [hzero] at huniv
  exact huniv rfl

/-- Second countability makes the reference Haar measure sigma-finite. -/
noncomputable instance
    fullAdelicCliffordSpinCandidateReferenceHaarMeasureSigmaFinite :
    SigmaFinite V.fullAdelicCliffordSpinCandidateReferenceHaarMeasure := by
  unfold fullAdelicCliffordSpinCandidateReferenceHaarMeasure Measure.haar
  infer_instance

/-- The reference Haar measure is regular. -/
theorem fullAdelicCliffordSpinCandidateReferenceHaarMeasure_regular :
    V.fullAdelicCliffordSpinCandidateReferenceHaarMeasure.Regular := by
  unfold fullAdelicCliffordSpinCandidateReferenceHaarMeasure Measure.haar
  infer_instance

/-! ## The exact quotient measure -/

/-- The quotient measure obtained by restricting the reference Haar measure
to a proposed fundamental domain and pushing it through the left-quotient
map.  No fundamental-domain property is asserted by this definition. -/
noncomputable def
    fullAdelicCliffordSpinCandidateReferenceFundamentalDomainQuotientMeasure
    (F : Set V.FullAdelicCliffordSpinCandidateGroup) :
    Measure V.FullAdelicCliffordSpinCandidateLeftQuotient :=
  leftQuotientFundamentalDomainMeasure
    V.rationalCliffordSpinCandidateFullAdelicDiagonalSubgroup
    V.fullAdelicCliffordSpinCandidateReferenceHaarMeasure F

/-- The total mass of the pushed-forward reference quotient measure is the
reference Haar mass of the proposed fundamental domain. -/
@[simp]
theorem
    fullAdelicCliffordSpinCandidateReferenceFundamentalDomainQuotientMeasure_univ
    (F : Set V.FullAdelicCliffordSpinCandidateGroup) :
    V.fullAdelicCliffordSpinCandidateReferenceFundamentalDomainQuotientMeasure F
        Set.univ =
      V.fullAdelicCliffordSpinCandidateReferenceHaarMeasure F := by
  unfold
    fullAdelicCliffordSpinCandidateReferenceFundamentalDomainQuotientMeasure
  exact leftQuotientFundamentalDomainMeasure_univ_map_mspace
    (Gamma := V.rationalCliffordSpinCandidateFullAdelicDiagonalSubgroup)
    (μG := V.fullAdelicCliffordSpinCandidateReferenceHaarMeasure)
    (F := F) rfl

/-- A quotient measure normalized relative to the reference Haar measure by
the sound measurable-integrand left Weil formula.

This structure does not assert invariant-differential normalization.  Its
existence remains an explicit quotient-measure input rather than a consequence
of local compactness alone. -/
structure CliffordSpinCandidateReferenceHaarMeasurableWeilMeasureData where
  quotientMeasure : Measure V.FullAdelicCliffordSpinCandidateLeftQuotient
  isMeasurableWeilQuotientMeasure :
    IsLeftMeasurableWeilQuotientMeasure
      V.rationalCliffordSpinCandidateFullAdelicDiagonalSubgroup
      V.fullAdelicCliffordSpinCandidateReferenceHaarMeasure
      quotientMeasure

namespace CliffordSpinCandidateReferenceHaarMeasurableWeilMeasureData

/-- Construct reference measurable-Weil data from a proposed fundamental
domain once the sole remaining analytic identity—the measurable
periodization integral over that domain—is supplied. Countability of the
rational diagonal and measurability of multiplication discharge the
periodization measurability side automatically. -/
noncomputable def ofFundamentalDomain
    (F : Set V.FullAdelicCliffordSpinCandidateGroup)
    (hfund :
      ∀ f : V.FullAdelicCliffordSpinCandidateGroup → ℝ≥0∞,
        Measurable f →
          ∫⁻ y,
              leftPeriodize
                V.rationalCliffordSpinCandidateFullAdelicDiagonalSubgroup f
                (V.fullAdelicCliffordSpinCandidateLeftQuotientMap y)
              ∂V.fullAdelicCliffordSpinCandidateReferenceHaarMeasure.restrict F =
            ∫⁻ y, f y
              ∂V.fullAdelicCliffordSpinCandidateReferenceHaarMeasure) :
    V.CliffordSpinCandidateReferenceHaarMeasurableWeilMeasureData where
  quotientMeasure :=
    V.fullAdelicCliffordSpinCandidateReferenceFundamentalDomainQuotientMeasure F
  isMeasurableWeilQuotientMeasure := by
    letI : Countable
        V.rationalCliffordSpinCandidateFullAdelicDiagonalSubgroup :=
      V.rationalCliffordSpinCandidateFullAdelicDiagonalSubgroup_countable
    constructor
    intro f hf
    unfold
      fullAdelicCliffordSpinCandidateReferenceFundamentalDomainQuotientMeasure
    rw [leftQuotientFundamentalDomainMeasure_eq_map_restrict]
    exact
      lintegral_leftPeriodize_eq_of_map_restrict_fundamentalDomain_countable
        (Gamma :=
          V.rationalCliffordSpinCandidateFullAdelicDiagonalSubgroup)
        (μG := V.fullAdelicCliffordSpinCandidateReferenceHaarMeasure)
        (F := F) rfl hf (hfund f hf)

/-- The total quotient mass at the arbitrary reference Haar scale.  This is
not called a Tamagawa number because no invariant-differential normalization
has been supplied. -/
def referenceQuotientVolumeENNReal
    (D : V.CliffordSpinCandidateReferenceHaarMeasurableWeilMeasureData) :
    ℝ≥0∞ :=
  D.quotientMeasure Set.univ

@[simp]
theorem referenceQuotientVolumeENNReal_eq
    (D : V.CliffordSpinCandidateReferenceHaarMeasurableWeilMeasureData) :
    D.referenceQuotientVolumeENNReal = D.quotientMeasure Set.univ :=
  rfl

end CliffordSpinCandidateReferenceHaarMeasurableWeilMeasureData

end RationalQuadraticSpaceMatrix
