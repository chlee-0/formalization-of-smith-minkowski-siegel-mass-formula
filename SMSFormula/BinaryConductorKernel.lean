import SMSFormula.BinaryConductorResidue

/-!
# The actual conductor connecting kernel

A trivial connecting class has a principal generator in the same field.
Its proved extension recovers an actual maximal-order unit. The remaining
factor comes from the original conductor residue order.
-/

open scoped nonZeroDivisors

namespace FractionalIdeal

variable {R F : Type*} [CommRing R] [IsDomain R] [Field F]
  [Algebra R F] [IsFractionRing R F]

/-- A trivial ideal class gives a nonzero principal generator, as
a unit of the same field. No principal-ideal certificate is supplied. -/
theorem exists_unit_generator_of_class_eq_one (U : (FractionalIdeal R⁰ F)ˣ)
    (h : ClassGroup.mk F U=1) :
    ∃ x : Fˣ, (U : FractionalIdeal R⁰ F)=spanSingleton R⁰ x.val := by
  letI := ClassGroup.mk_eq_one_iff.mp h
  let x := Submodule.IsPrincipal.generator (U : Submodule R F)
  have hx : (U : FractionalIdeal R⁰ F)=spanSingleton R⁰ x := by
    apply FractionalIdeal.coeToSubmodule_injective
    change (U : Submodule R F)=(spanSingleton R⁰ x : Submodule R F)
    rw [coe_spanSingleton]
    exact (Submodule.IsPrincipal.span_singleton_generator _).symm
  have hx0 : x ≠ 0 := by
    intro hzero
    apply Units.ne_zero U
    rw [hx,hzero,spanSingleton_zero]
  exact ⟨Units.mk0 x hx0,hx⟩

end FractionalIdeal

namespace BinaryNormIdeal

variable (a b c : ℤ) [IsDomain (CoefficientOrder a b c)]

/-- The actual reduction of maximal-order units modulo the conductor. -/
noncomputable def integerConductorResidueUnitsHom :
    (NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))ˣ →*
      ConductorResidueUnits a b c :=
  Units.map (Ideal.Quotient.mk (orderConductor a b c)).toMonoidHom

/-- Maximal-order units in the actual quotient by original residue units. -/
noncomputable def integerConductorResidueQuotientHom :
    (NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))ˣ →*
      ConductorResidueUnitQuotient a b c :=
  (QuotientGroup.mk' (originalConductorResidueUnitsHom a b c).range).comp
    (integerConductorResidueUnitsHom a b c)

/-- A principal generator whose extension is B is an actual B unit. -/
theorem exists_integerUnit_of_principal_extension (hD : b^2-4*a*c < 0)
    (x : (FractionRing (CoefficientOrder a b c))ˣ)
    (h : FractionalIdeal.spanSingleton (CoefficientOrder a b c)⁰ x.val *
      maximalOrderFractionalIdeal a b c hD = maximalOrderFractionalIdeal a b c hD) :
    ∃ u : (NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))ˣ,
      algebraMap _ _ u.val=x.val := by
  have h1 := FractionalIdeal.one_le.mp (one_le_maximalOrderFractionalIdeal a b c hD)
  have hx : x.val ∈ maximalOrderFractionalIdeal a b c hD := by
    rw [← h]
    simpa using FractionalIdeal.mul_mem_mul
      (FractionalIdeal.mem_spanSingleton_self (CoefficientOrder a b c)⁰ x.val) h1
  obtain ⟨u,hu⟩ := (mem_maximalOrderFractionalIdeal a b c hD _).mp hx
  have h1prod : (1 : FractionRing (CoefficientOrder a b c)) ∈
      FractionalIdeal.spanSingleton (CoefficientOrder a b c)⁰ x.val *
        maximalOrderFractionalIdeal a b c hD := by rw [h]; exact h1
  obtain ⟨y,hy,hxy⟩ := FractionalIdeal.mem_singleton_mul.mp h1prod
  obtain ⟨v,hv⟩ := (mem_maximalOrderFractionalIdeal a b c hD y).mp hy
  have huv : u*v=1 := by
    apply Subtype.ext
    change algebraMap _ (FractionRing (CoefficientOrder a b c)) (u*v)=
      (1 : FractionRing (CoefficientOrder a b c))
    rw [map_mul,hu,hv]
    exact hxy.symm
  refine ⟨⟨u,v,huv,?_⟩,hu⟩
  exact (mul_comm v u).trans huv

/-- A trivial residue connecting class is principal with generator an
Actual maximal-order unit, using the already proved extension identity. -/
theorem exists_integerUnit_generator_of_conductorClass_eq_one (hD : b^2-4*a*c < 0)
    (q : ConductorResidueUnits a b c) (h : conductorResidueClassHom a b c hD q=1) :
    ∃ u : (NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))ˣ,
      (residueConnectingIdealUnit a b c hD q :
        FractionalIdeal (CoefficientOrder a b c)⁰ (FractionRing (CoefficientOrder a b c))) =
          FractionalIdeal.spanSingleton _ (algebraMap _ _ u.val) := by
  obtain ⟨x,hx⟩ := FractionalIdeal.exists_unit_generator_of_class_eq_one
    (residueConnectingIdealUnit a b c hD q) h
  have hext := residueConnectingIdeal_mul_maximalOrder a b c hD q
  rw [hx] at hext
  obtain ⟨u,hu⟩ := exists_integerUnit_of_principal_extension a b c hD x hext
  exact ⟨u,by rw [hu]; exact hx⟩

/-- A connecting ideal generated by an actual B unit recovers an actual
original-order residue unit. Both residue lifts remain in the same field. -/
theorem exists_originalResidueUnit_of_integerUnit_generator (hD : b^2-4*a*c < 0)
    (q : ConductorResidueUnits a b c)
    (z : (NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))ˣ)
    (hz : (residueConnectingIdealUnit a b c hD q :
      FractionalIdeal (CoefficientOrder a b c)⁰ (FractionRing (CoefficientOrder a b c))) =
        FractionalIdeal.spanSingleton _ (algebraMap _ _ z.val)) :
    ∃ t : (CoefficientOrder a b c ⧸ originalConductorIdeal a b c)ˣ,
      q = integerConductorResidueUnitsHom a b c z * originalConductorResidueUnitsHom a b c t := by
  let u := conductorResidueLift a b c q
  let v := conductorResidueLift a b c q⁻¹
  have hu : algebraMap _ _ u ∈ conductorConnectingIdeal a b c hD u :=
    FractionalIdeal.generator_mem_conductorLine _ _
  have hv : algebraMap _ _ v ∈ conductorConnectingIdeal a b c hD v :=
    FractionalIdeal.generator_mem_conductorLine _ _
  change conductorConnectingIdeal a b c hD u = _ at hz
  have hu' := hu
  rw [hz] at hu'
  obtain ⟨r,hr⟩ := (FractionalIdeal.mem_spanSingleton _).mp hu'
  have hru : orderToRingOfIntegers a b c r*z.val=u := by
    apply Subtype.ext
    change algebraMap _ (FractionRing (CoefficientOrder a b c))
      (orderToRingOfIntegers a b c r*z.val) = algebraMap _ _ u
    simpa only [map_mul,orderToRingOfIntegers_coe,Algebra.smul_def] using hr
  have hzmem : algebraMap _ _ z.val ∈ conductorConnectingIdeal a b c hD u := by
    rw [hz]
    exact FractionalIdeal.mem_spanSingleton_self _ _
  have hprod : algebraMap _ _ z.val * algebraMap _ _ v ∈
      (1 : FractionalIdeal (CoefficientOrder a b c)⁰ (FractionRing (CoefficientOrder a b c))) := by
    rw [← conductorConnectingIdeal_mul_inverse a b c hD u v
      (conductorResidueLift_mul_inv_sub_mem a b c q)]
    exact FractionalIdeal.mul_mem_mul hzmem hv
  obtain ⟨s,hs⟩ := (FractionalIdeal.mem_one_iff _).mp hprod
  have hsv : orderToRingOfIntegers a b c s=z.val*v := by
    apply Subtype.ext
    change algebraMap _ (FractionRing (CoefficientOrder a b c))
      (orderToRingOfIntegers a b c s)=algebraMap _ _ (z.val*v)
    simpa only [map_mul,orderToRingOfIntegers_coe] using hs
  have hrs : r*s-1 ∈ originalConductorIdeal a b c := by
    change orderToRingOfIntegers a b c (r*s-1) ∈ orderConductor a b c
    rw [map_sub,map_mul,map_one,hsv,← mul_assoc,hru]
    exact conductorResidueLift_mul_inv_sub_mem a b c q
  let t : (CoefficientOrder a b c ⧸ originalConductorIdeal a b c)ˣ :=
    { val := Ideal.Quotient.mk _ r
      inv := Ideal.Quotient.mk _ s
      val_inv := by
        rw [← map_mul]
        exact (Ideal.Quotient.mk_eq_one_iff_sub_mem _).mpr hrs
      inv_val := by
        rw [← map_mul,mul_comm s r]
        exact (Ideal.Quotient.mk_eq_one_iff_sub_mem _).mpr hrs }
  refine ⟨t,?_⟩
  apply Units.ext
  change q.val=Ideal.Quotient.mk _ z.val * Ideal.Quotient.mk _ (orderToRingOfIntegers a b c r)
  rw [← mk_conductorResidueLift a b c q,← map_mul]
  apply congrArg (Ideal.Quotient.mk (orderConductor a b c))
  exact hru.symm.trans (mul_comm _ _)

/-- The complete kernel criterion BEFORE quotienting original residue units. -/
theorem conductorResidueClassHom_eq_one_iff (hD : b^2-4*a*c < 0)
    (q : ConductorResidueUnits a b c) :
    conductorResidueClassHom a b c hD q=1 ↔
      ∃ z : (NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))ˣ,
      ∃ t : (CoefficientOrder a b c ⧸ originalConductorIdeal a b c)ˣ,
        q=integerConductorResidueUnitsHom a b c z * originalConductorResidueUnitsHom a b c t := by
  constructor
  · intro h
    obtain ⟨z,hz⟩ := exists_integerUnit_generator_of_conductorClass_eq_one a b c hD q h
    obtain ⟨t,ht⟩ := exists_originalResidueUnit_of_integerUnit_generator a b c hD q z hz
    exact ⟨z,t,ht⟩
  · rintro ⟨z,t,rfl⟩
    rw [map_mul]
    have hz : conductorResidueClassHom a b c hD (integerConductorResidueUnitsHom a b c z)=1 :=
      conductorResidueClassHom_integerUnit a b c hD z
    rw [hz,conductorResidueClassHom_originalResidueUnit,mul_one]

/-- The complete kernel in the actual quotient residue-unit carrier. -/
theorem conductorResidueQuotientClassHom_ker (hD : b^2-4*a*c < 0) :
    (conductorResidueQuotientClassHom a b c hD).ker =
      (integerConductorResidueQuotientHom a b c).range := by
  ext q
  refine QuotientGroup.induction_on q (fun r => ?_)
  change conductorResidueClassHom a b c hD r=1 ↔
    ∃ z, integerConductorResidueQuotientHom a b c z=QuotientGroup.mk r
  constructor
  · intro h
    obtain ⟨z,t,ht⟩ := (conductorResidueClassHom_eq_one_iff a b c hD r).mp h
    refine ⟨z,?_⟩
    change (QuotientGroup.mk' (originalConductorResidueUnitsHom a b c).range)
      (integerConductorResidueUnitsHom a b c z) =
        (QuotientGroup.mk' (originalConductorResidueUnitsHom a b c).range) r
    have ho : (QuotientGroup.mk' (originalConductorResidueUnitsHom a b c).range)
        (originalConductorResidueUnitsHom a b c t)=1 :=
      (QuotientGroup.eq_one_iff _).mpr ⟨t,rfl⟩
    rw [ht,map_mul,ho]
    exact (mul_one ((QuotientGroup.mk' (originalConductorResidueUnitsHom a b c).range)
      (integerConductorResidueUnitsHom a b c z))).symm
  · rintro ⟨z,hz⟩
    have h := congrArg (conductorResidueQuotientClassHom a b c hD) hz
    change conductorResidueClassHom a b c hD (integerConductorResidueUnitsHom a b c z)=
      conductorResidueClassHom a b c hD r at h
    exact h.symm.trans (conductorResidueClassHom_integerUnit a b c hD z)

/-- Matching a residue from the original order forces actual original
order membership, since the literal conductor already lies in that order. -/
theorem mem_orderImage_of_matching_residue
    (z : NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))
    (r : CoefficientOrder a b c)
    (h : Ideal.Quotient.mk (orderConductor a b c) (orderToRingOfIntegers a b c r)=
      Ideal.Quotient.mk (orderConductor a b c) z) : z ∈ orderImage a b c := by
  have hsub : z-orderToRingOfIntegers a b c r ∈ orderConductor a b c :=
    Ideal.Quotient.eq.mp h.symm
  have hmem : z-orderToRingOfIntegers a b c r ∈ orderImage a b c := by
    simpa using hsub 1
  have hr : orderToRingOfIntegers a b c r ∈ orderImage a b c := ⟨r,rfl⟩
  simpa using (orderImage a b c).add_mem hmem hr

/-- Every maximal-order unit in the original residue-unit image comes from
an actual original-order unit, including its actual inverse. -/
theorem exists_orderUnit_of_integerUnit_matching_residue
    (z : (NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))ˣ)
    (t : (CoefficientOrder a b c ⧸ originalConductorIdeal a b c)ˣ)
    (h : originalConductorResidueUnitsHom a b c t=integerConductorResidueUnitsHom a b c z) :
    ∃ u : (CoefficientOrder a b c)ˣ, coefficientUnitsToIntegerUnits a b c u=z := by
  have hmem (w : (NumberField.RingOfIntegers (FractionRing (CoefficientOrder a b c)))ˣ)
      (s : (CoefficientOrder a b c ⧸ originalConductorIdeal a b c)ˣ)
      (hs : originalConductorResidueUnitsHom a b c s=integerConductorResidueUnitsHom a b c w) :
      w.val ∈ orderImage a b c := by
    let r : CoefficientOrder a b c := Quotient.out s.val
    apply mem_orderImage_of_matching_residue a b c _ r
    have hr : Ideal.Quotient.mk (originalConductorIdeal a b c) r=s.val := Ideal.Quotient.mk_out _
    change originalConductorResidueMap a b c (Ideal.Quotient.mk _ r)=_
    rw [hr]
    exact congrArg Units.val hs
  obtain ⟨r,hr⟩ := hmem z t h
  have hinv : originalConductorResidueUnitsHom a b c t⁻¹=
      integerConductorResidueUnitsHom a b c z⁻¹ := by
    rw [map_inv,map_inv,h]
  obtain ⟨s,hs⟩ := hmem z⁻¹ t⁻¹ hinv
  change orderToRingOfIntegers a b c r=z.val at hr
  change orderToRingOfIntegers a b c s=z⁻¹.val at hs
  have hrs : r*s=1 := by
    apply orderToRingOfIntegers_injective a b c
    rw [map_mul,map_one,hr,hs]
    simp
  let u : (CoefficientOrder a b c)ˣ :=
    ⟨r,s,hrs,(mul_comm s r).trans hrs⟩
  refine ⟨u,?_⟩
  apply Units.ext
  exact hr

/-- The kernel of B.units -> (B/C).units/image(A/C_A).units is exactly
the actual original-order unit image, without a caller unit certificate. -/
theorem integerConductorResidueQuotientHom_ker :
    (integerConductorResidueQuotientHom a b c).ker =
      (coefficientUnitsToIntegerUnits a b c).range := by
  ext z
  change integerConductorResidueQuotientHom a b c z=1 ↔
    ∃ u, coefficientUnitsToIntegerUnits a b c u=z
  change (QuotientGroup.mk' (originalConductorResidueUnitsHom a b c).range)
    (integerConductorResidueUnitsHom a b c z)=1 ↔ _
  constructor
  · intro h
    obtain ⟨t,ht⟩ := (QuotientGroup.eq_one_iff _).mp h
    exact exists_orderUnit_of_integerUnit_matching_residue a b c z t ht
  · rintro ⟨u,rfl⟩
    apply (QuotientGroup.eq_one_iff _).mpr
    refine ⟨Units.map (Ideal.Quotient.mk (originalConductorIdeal a b c)).toMonoidHom u,?_⟩
    apply Units.ext
    rfl

/-- The unit correction in the connecting kernel is the already defined
actual order-unit index, not a numerical replacement for it. -/
theorem card_integerConductorResidueQuotientHom_range :
    Nat.card (integerConductorResidueQuotientHom a b c).range=orderUnitIndex a b c := by
  have h := Nat.card_congr (QuotientGroup.quotientKerEquivRange
    (integerConductorResidueQuotientHom a b c)).toEquiv
  rw [integerConductorResidueQuotientHom_ker] at h
  exact h.symm

/-- The COMPLETE actual connecting kernel has cardinal the proved unit
index U. This is separate from any evaluated residue-unit quotient. -/
theorem card_conductorResidueQuotientClassHom_ker (hD : b^2-4*a*c < 0) :
    Nat.card (conductorResidueQuotientClassHom a b c hD).ker=orderUnitIndex a b c := by
  rw [conductorResidueQuotientClassHom_ker,card_integerConductorResidueQuotientHom_range]

/-- The actual connecting kernel is finite, without assuming the whole
residue-unit quotient finite or substituting a class number for its count. -/
theorem finite_conductorResidueQuotientClassHom_ker (hD : b^2-4*a*c < 0) :
    Finite (conductorResidueQuotientClassHom a b c hD).ker := by
  apply Nat.finite_of_card_ne_zero
  rw [card_conductorResidueQuotientClassHom_ker]
  exact ne_of_gt (orderUnitIndex_pos a b c hD)

/-- Exact cardinal normalization of the actual residue quotient and
connecting image by the actual unit correction. No Euler count is used. -/
theorem card_conductorResidueQuotient_eq_image_mul_unitIndex (hD : b^2-4*a*c < 0) :
    Nat.card (ConductorResidueUnitQuotient a b c) =
      Nat.card (conductorResidueQuotientClassHom a b c hD).range * orderUnitIndex a b c := by
  have h := Subgroup.card_eq_card_quotient_mul_card_subgroup
    (conductorResidueQuotientClassHom a b c hD).ker
  rw [Nat.card_congr (QuotientGroup.quotientKerEquivRange
      (conductorResidueQuotientClassHom a b c hD)).toEquiv,
    card_conductorResidueQuotientClassHom_ker] at h
  exact h

end BinaryNormIdeal

namespace PositiveDefiniteIntegralLattice

/-- The complete actual kernel for K's original order. -/
theorem binaryConductorResidueQuotientClassHom_ker (K : PositiveDefiniteIntegralLattice 2) :
    letI := K.binaryDiscriminantOrder_isDomain
    K.binaryConductorResidueQuotientClassHom.ker =
      (BinaryNormIdeal.integerConductorResidueQuotientHom 1 (K.binaryPrimitiveDiscriminant%2)
        (((K.binaryPrimitiveDiscriminant%2)^2-K.binaryPrimitiveDiscriminant)/4)).range := by
  letI := K.binaryDiscriminantOrder_isDomain
  exact BinaryNormIdeal.conductorResidueQuotientClassHom_ker _ _ _
    K.binaryDiscriminantOrder_discriminant_neg

/-- The actual kernel count is K's already defined unit index U. -/
theorem card_binaryConductorResidueQuotientClassHom_ker (K : PositiveDefiniteIntegralLattice 2) :
    letI := K.binaryDiscriminantOrder_isDomain
    Nat.card K.binaryConductorResidueQuotientClassHom.ker = K.binaryOrderUnitIndex := by
  letI := K.binaryDiscriminantOrder_isDomain
  exact BinaryNormIdeal.card_conductorResidueQuotientClassHom_ker _ _ _
    K.binaryDiscriminantOrder_discriminant_neg

theorem finite_binaryConductorResidueQuotientClassHom_ker (K : PositiveDefiniteIntegralLattice 2) :
    letI := K.binaryDiscriminantOrder_isDomain
    Finite K.binaryConductorResidueQuotientClassHom.ker := by
  letI := K.binaryDiscriminantOrder_isDomain
  exact BinaryNormIdeal.finite_conductorResidueQuotientClassHom_ker _ _ _
    K.binaryDiscriminantOrder_discriminant_neg

/-- Positive quotient cardinal follows from the already proved class-group
finiteness and the complete finite kernel. It assumes no residue count. -/
theorem binaryConductorResidueUnitQuotient_card_pos (K : PositiveDefiniteIntegralLattice 2) :
    letI := K.binaryDiscriminantOrder_isDomain
    0 < Nat.card (BinaryNormIdeal.ConductorResidueUnitQuotient 1 (K.binaryPrimitiveDiscriminant%2)
      (((K.binaryPrimitiveDiscriminant%2)^2-K.binaryPrimitiveDiscriminant)/4)) := by
  letI := K.binaryDiscriminantOrder_isDomain
  letI := K.finite_binaryClassGroup
  rw [BinaryNormIdeal.card_conductorResidueQuotient_eq_image_mul_unitIndex _ _ _
    K.binaryDiscriminantOrder_discriminant_neg]
  exact mul_pos Nat.card_pos K.binaryOrderUnitIndex_pos

theorem finite_binaryConductorResidueUnitQuotient (K : PositiveDefiniteIntegralLattice 2) :
    letI := K.binaryDiscriminantOrder_isDomain
    Finite (BinaryNormIdeal.ConductorResidueUnitQuotient 1 (K.binaryPrimitiveDiscriminant%2)
      (((K.binaryPrimitiveDiscriminant%2)^2-K.binaryPrimitiveDiscriminant)/4)) := by
  letI := K.binaryDiscriminantOrder_isDomain
  exact Nat.finite_of_card_ne_zero (ne_of_gt K.binaryConductorResidueUnitQuotient_card_pos)

end PositiveDefiniteIntegralLattice

