import SMSFormula.QuadraticAnisotropicDecompositionIsometry
import SMSFormula.RationalCliffordReflectionPairArbitraryBase

/-!
# Intrinsic anisotropic decomposition of a rational quadratic space

This file specializes the generic anisotropic orthogonal-sum isometry to the
repository's rational matrix-backed quadratic space.  For a rational vector
`x` of nonzero norm, it packages the canonical decomposition

`x⊥ orthogonal_sum <q(x)> ≃q V`.

The one-dimensional coordinate is generated by `x` itself.  In particular,
the construction selects neither a basis of `x⊥` nor an isometry to a fresh
matrix presentation.
-/

noncomputable section

namespace RationalQuadraticSpaceMatrix

variable {n : ℕ}

/-- The rational quadratic form on the native coordinate carrier. -/
abbrev nativeRationalQuadraticForm (V : RationalQuadraticSpaceMatrix n) :
    QuadraticForm ℚ (Fin n → ℚ) :=
  V.quadraticForm

/-- The intrinsic polar orthogonal complement of a rational vector. -/
abbrev anisotropicRationalOrthogonalComplement
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ) :
    Submodule ℚ (Fin n → ℚ) :=
  V.nativeRationalQuadraticForm.anisotropicOrthogonal x

/-- The intrinsic orthogonal-sum form `x⊥ orthogonal_sum <q(x)>`. -/
abbrev anisotropicRationalOrthogonalSum
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ) :
    QuadraticForm ℚ (V.anisotropicRationalOrthogonalComplement x × ℚ) :=
  V.nativeRationalQuadraticForm.anisotropicOrthogonalSum x

/-- The canonical rational quadratic isometry from the orthogonal complement
plus the norm line to the original ambient quadratic space. -/
def anisotropicRationalDecompositionIsometryEquiv
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ)
    (hx : V.nativeRationalQuadraticForm x ≠ 0) :
    (V.anisotropicRationalOrthogonalSum x).IsometryEquiv
      V.nativeRationalQuadraticForm :=
  V.nativeRationalQuadraticForm.anisotropicOrthogonalDecompositionIsometryEquiv
    x hx

@[simp]
theorem anisotropicRationalDecompositionIsometryEquiv_apply
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ)
    (hx : V.nativeRationalQuadraticForm x ≠ 0)
    (z : V.anisotropicRationalOrthogonalComplement x) (a : ℚ) :
    V.anisotropicRationalDecompositionIsometryEquiv x hx (z, a) =
      a • x + z :=
  V.nativeRationalQuadraticForm
    |>.anisotropicOrthogonalDecompositionIsometryEquiv_apply x hx z a

@[simp]
theorem anisotropicRationalNormLine_apply
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ) (a : ℚ) :
    V.nativeRationalQuadraticForm.anisotropicScalarLine x a =
      a ^ 2 * V.nativeRationalQuadraticForm x :=
  V.nativeRationalQuadraticForm.anisotropicScalarLine_apply_eq_sq_mul x a

/-- The intrinsic complement has the expected rank drop. -/
theorem finrank_anisotropicRationalOrthogonalComplement_add_one
    (V : RationalQuadraticSpaceMatrix n) (x : Fin n → ℚ)
    (hx : V.nativeRationalQuadraticForm x ≠ 0) :
    Module.finrank ℚ (V.anisotropicRationalOrthogonalComplement x) + 1 = n := by
  simpa using
    V.nativeRationalQuadraticForm.finrank_anisotropicOrthogonal_add_one x hx

end RationalQuadraticSpaceMatrix
